{
  "name": "omlx-mcp",
  "version": "0.13.0",
  "description": "MCP server exposing a local omlx inference server (chat, structured output, model status) so coding agents can delegate bulk work to a local model.",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite-node src/dev.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "RUN_LIVE=1 vitest run test/live.test.ts"
  },
  "keywords": [
    "mcp",
    "omlx",
    "mlx",
    "local-llm",
    "model-context-protocol"
  ],
  "author": "v1nvn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v1nvn/agentic.git",
    "directory": "omlx-mcp"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
