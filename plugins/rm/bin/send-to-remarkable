#!/usr/bin/env bash
# Convert a Markdown file (or stdin) to EPUB and push it to the reMarkable.
# Canonical converter — also callable as `just send` (thin wrapper).
#
#   send-to-remarkable path/to/reply.md     # from a file
#   send-to-remarkable -                    # from stdin
#   send-to-remarkable                      # from stdin (same as -)
#
# Env knobs: REMARKABLE_HOST (default: remarkable), REMARKABLE_DIR (default: /home/root/books)
set -euo pipefail

HOST="${REMARKABLE_HOST:-remarkable}"
DIR="${REMARKABLE_DIR:-/home/root/books}"
src="${1:--}"

tmp_md="$(mktemp -t rm-XXXX).md"
if [[ "$src" == "-" ]]; then
    cat > "$tmp_md"
elif [[ -f "$src" ]]; then
    cp "$src" "$tmp_md"
else
    echo "no such file: $src" >&2
    exit 1
fi

# Title = first Markdown heading, else a timestamp. `|| true` so a heading-less
# reply doesn't trip `set -e` (grep returns non-zero on no match).
title="$(grep -m1 '^#' "$tmp_md" | sed -E 's/^#+[[:space:]]*//' || true)"
title="${title:-Claude reply $(date '+%Y-%m-%d %H:%M')}"

epub="$(mktemp -t rm-XXXX).epub"
pandoc "$tmp_md" -o "$epub" --metadata title="$title"

# Slugify the title into a safe filename.
safe="$(printf '%s' "$title" | tr -cs '[:alnum:]' '_' | cut -c1-60)"

ssh "$HOST" "mkdir -p '$DIR'"
scp -q "$epub" "$HOST:$DIR/${safe}.epub"
echo "Sent: ${safe}.epub → $HOST:$DIR"

rm -f "$tmp_md" "$epub"
