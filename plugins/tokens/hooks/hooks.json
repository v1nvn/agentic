{
  "description": "Zero-token token-usage report from local transcripts",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^tokens:usage$",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["-y", "@v1nvn/tokens@0.17.0", "--hook"]
          }
        ]
      }
    ]
  }
}
