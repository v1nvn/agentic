{
  "description": "Zero-token send of the last reply to the Markdown-Viewer",
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^md:send$",
        "hooks": [
          {
            "type": "command",
            "command": "npx",
            "args": ["-y", "@v1nvn/md@0.15.0", "--hook"]
          }
        ]
      }
    ]
  }
}
