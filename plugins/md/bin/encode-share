#!/usr/bin/env bash
# Encode Markdown (stdin or a file) into the Markdown-Viewer share token.
#
# Pipeline: UTF-8 bytes → zlib deflate (RFC 1950, pako.deflate-compatible) → base64url.
# Matches Markdown-Viewer's encodeMarkdownForShare() in script.js byte-for-byte — the
# decoder (pako.inflate) accepts any valid zlib stream, so compression level is irrelevant.
#
#   encode-share            # from stdin
#   encode-share file.md    # from a file
#   encode-share -          # from stdin (explicit)
#
# Verified: encode-share of "Hi" → eJzzyAQAAPsAsg (matches the live viewer).
set -euo pipefail
src="${1:--}"

read_input() {
    if [[ "$src" == "-" ]]; then cat
    elif [[ -f "$src" ]]; then cat "$src"
    else echo "no such file: $src" >&2; exit 1
    fi
}

if command -v node >/dev/null 2>&1; then
    read_input | node -e '
        const zlib = require("zlib");
        const chunks = [];
        process.stdin.on("data", c => chunks.push(c));
        process.stdin.on("end", () => {
            const out = zlib.deflateSync(Buffer.concat(chunks));
            const b64 = out.toString("base64")
                .replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
            process.stdout.write(b64);
        });
    '
elif command -v python3 >/dev/null 2>&1; then
    read_input | python3 -c '
import sys, zlib, base64
data = sys.stdin.buffer.read()
c = zlib.compress(data)
sys.stdout.write(base64.b64encode(c).decode().replace("+", "-").replace("/", "_").rstrip("="))
'
else
    echo "neither node nor python3 found" >&2
    exit 1
fi
