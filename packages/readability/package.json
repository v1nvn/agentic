{
  "name": "@v1nvn/readability",
  "version": "0.55.1",
  "description": "MCP server that turns rendered (post-JS) HTML into clean Markdown + metadata via Readability, Turndown, and DOMPurify.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": "./src/index.ts",
  "scripts": {
    "bench": "vite-node test/bench/run.ts",
    "dev": "vite-node src/dev.ts",
    "start": "node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-goldens": "UPDATE_GOLDENS=1 vitest run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "readability",
    "url-to-markdown",
    "markdown",
    "turndown",
    "model-context-protocol"
  ],
  "author": {
    "name": "v1nvn",
    "email": "v1n@outlook.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v1nvn/agentic.git",
    "directory": "packages/readability"
  },
  "homepage": "https://github.com/v1nvn/agentic/tree/main/packages/readability",
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@v1nvn/agentic-core": "workspace:^",
    "dompurify": "^3.4.17",
    "jsdom": "^30.1.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.5",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
