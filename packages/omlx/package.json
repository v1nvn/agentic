  "main": "./src/index.ts",
  "bin": "./src/index.ts",
  "scripts": {
    "dev": "vite-node src/dev.ts",
    "start": "node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "RUN_LIVE=1 vitest run test/live.test.ts"
  },
  "keywords": [
    "mcp",
    "omlx",
    "mlx",
    "local-llm",
    "model-context-protocol"
  ],
  "author": {
    "name": "v1nvn",
    "email": "v1n@outlook.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v1nvn/agentic.git",
    "directory": "packages/omlx"
  },
  "homepage": "https://github.com/v1nvn/agentic/tree/main/packages/omlx",
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@v1nvn/agentic-core": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
