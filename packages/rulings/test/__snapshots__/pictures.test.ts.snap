exports[`bodies view > pins the option diff: its own body only, prism tokens, needs chip 1`] = `"<section class="view o-a"><div class="vhead"><span class="lt">a</span><div class="vtt"><span class="vt">Drop the clobbering exitOverride() call</span><span class="vmeta"><span class="star">★ my pick</span> · <span class="dep">needs G1a</span></span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="bodies"><div class="body of-option"><div class="tag"><span class="lt">a</span><span>planned</span><span class="dleg">diff vs today</span></div><pre class="diff"><span class="dl ctx"><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span></span><span class="dl ctx">  command</span><span class="dl ctx">    <span class="token punctuation">.</span><span class="token function">allowExcessArguments</span><span class="token punctuation">(</span><span class="token boolean">false</span><span class="token punctuation">)</span></span><span class="dl del">    <span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span><span class="token punctuation">)</span></span><span class="dl ctx">    <span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span></span><span class="dl ctx">      <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl ctx">      <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl ctx">    <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl ctx">  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>quiet<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl ctx"><span class="token punctuation">}</span></span></pre><p class="bcap">Write the after-code in full; the engine computes and tints the delta. A long unchanged run collapses on its own.</p></div></div></div></section>"`;

exports[`bodies view > pins the sketch body: state chip, no diff 1`] = `
"<section class="view o-b"><div class="vhead"><span class="lt">b</span><div class="vtt"><span class="vt">Keep the clobber; classify the error in recover</span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="bodies"><div class="body of-option"><div class="tag"><span class="lt">b</span><span class="state-chip">sketch — feasibility not checked</span></div><pre>parseQuietly(program, args, err =&gt;
  err instanceof HelpRequested
    ? { help: err.command }
    : commanderCode(err) === &quot;commander.helpDisplayed&quot;
      ? { help: currentCommand(program) }
      : undefined,
)</pre><p class="bcap">A sketch: feasibility not checked. diff: false keeps side-by-side snapshots when the pair is not the same code.</p></div></div></div></section>"
`;

exports[`bodies view > pins the today block: shown once, what label, cap caption, no diff 1`] = `
"<section class="view today"><div class="vhead"><span class="vt">Today</span><span class="vmeta">how it works now</span></div><div class="stage"><div class="bodies"><div class="body is-today"><div class="tag"><span>built today</span><b>The quiet walk core runs on every command, today.</b></div><pre><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span>
  command
    <span class="token punctuation">.</span><span class="token function">allowExcessArguments</span><span class="token punctuation">(</span><span class="token boolean">false</span><span class="token punctuation">)</span>
    <span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span><span class="token punctuation">)</span>
    <span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span>
      <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
      <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
    <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>quiet<span class="token punctuation">)</span><span class="token punctuation">;</span>
<span class="token punctuation">}</span></pre><p class="bcap">From <code>core/src/cli.ts:8-17</code>. The engine computes and tints the delta against each option.</p></div></div></div></section>"
`;

exports[`diagram view > pins the today view and an option view: container, escaped text, cap, head 1`] = `
"<section class="view"><div class="vhead"><span class="vt">Today</span><span class="vmeta">how it works now</span></div><div class="stage diagram"><div class="mermaid">flowchart TD
  R[daemon restarts] --&gt; L[window lost]
  L --&gt; V[read pays the holder half into the void]
  V --&gt; P[a human rebuilds the window from the console]
  P --&gt; A[the read pays the band again]</div><p class="cap"><b>Today a crash loses the window; the read pays into the void until a human rebuilds it.</b></p></div></section>"
`;

exports[`diagram view > pins the today view and an option view: container, escaped text, cap, head 2`] = `
"<section class="view o-a"><div class="vhead"><span class="lt">a</span><div class="vtt"><span class="vt">The daemon re-arms its windows from Postgres on start</span><span class="vmeta"><span class="star">★ my pick</span></span></div><span class="pmark">✓ picked</span></div><div class="stage diagram"><div class="mermaid">flowchart TD
  R[daemon restarts] --&gt; S[daemon reads the window from Postgres]
  S --&gt; A[the read pays the band again]</div><p class="cap"><b>Option a: the daemon re-arms its windows from Postgres on start.</b> No void window.</p></div></section>"
`;

exports[`seq view > pins the option view: overlay expansion, changed tag, band, per-view cap 1`] = `"<section class="view o-b"><div class="vhead"><span class="lt">b</span><div class="vtt"><span class="vt">The leaf also gets a band inside the window</span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 366" style="min-width:760px" role="img" aria-label="Today 10 paid leaf blocks have no owner. A read of them pays no holder."><rect class="ledger-bg" x="784" y="8" width="336" height="352" rx="4"/><rect class="band" x="4" y="152" width="768" height="66" rx="3"/><rect class="band" x="4" y="316" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="358"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="358"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="358"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="358"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</