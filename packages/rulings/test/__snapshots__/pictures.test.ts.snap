exports[`diagram view > pins the today view and an option view: container, escaped text, cap, head 2`] = `
"<section class="view o-a"><div class="vhead"><span class="lt">a</span><div class="vtt"><span class="vt">Re-arm on start</span><span class="vmeta"><span class="star">★ my pick</span></span></div><span class="pmark">✓ picked</span></div><div class="stage diagram"><div class="mermaid">flowchart TD
  R[daemon restarts] --&gt; S[window read from Postgres] --&gt; A[the read pays the band]</div><p class="cap"><b>Option a: the daemon re-arms from Postgres.</b></p></div><div class="gc gain"><span class="sign">+</span><span>g</span></div><div class="gc cost"><span class="sign">−</span><span>c</span></div></section>"
`;

exports[`seq view > pins the option view: overlay expansion, changed tag, band, per-view cap 1`] = `"<section class="view o-b"><div class="vhead"><span class="lt">b</span><div class="vtt"><span class="vt">The leaf also gets a band inside the window</span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 218" style="min-width:760px" role="img" aria-label="Option b: all 20 paid leaf blocks have an owner. The read pays Paul."><rect class="ledger-bg" x="784" y="8" width="336" height="204" rx="4"/><rect class="band" x="4" y="98" width="768" height="66" rx="3"/><rect class="band" x="4" y="168" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="210"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="210"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="210"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="210"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g><text class="num" x="14" y="122" text-anchor="middle">2</text><g class="tg tg-changed"><rect x="26" y="109" width="58" height="18" rx="9"/><text x="55" y="122" text-anchor="middle">changed</text></g><g class="e k-store"><line x1="347" y1="118" x2="513" y2="118"/><polygon class="head" points="517,118 508,113 508,123"/><text x="432" y="110" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="134" text-anchor="middle">bands [30, 40) and [40, 50)</text></g></g><text class="note" x="432" y="148" text-anchor="middle">the in-window blocks get a leaf band too</text><text class="bal chg" x="844" y="122" text-anchor="middle">20</text><text class="bal" x="952" y="122" text-anchor="middle">0</text><text class="bal" x="1060" y="122" text-anchor="middle">0</text><g><text class="num" x="14" y="192" text-anchor="middle">5</text><g class="tg tg-changed"><rect x="26" y="179" width="58" height="18" rx="9"/><text x="55" y="192" text-anchor="middle">changed</text></g><g class="self k-money"><rect x="216.8" y="175" width="260.4" height="26" rx="13"/><text x="347" y="192" text-anchor="middle">holder half goes to Paul’s leaf band</text></g></g><text class="bal" x="844" y="192" text-anchor="middle">20</text><text class="bal" x="952" y="192" text-anchor="middle">0</text><text class="bal chg" x="1060" y="192" text-anchor="middle">½ fee</text></svg></div><p class="cap"><b>Option b: all 20 paid leaf blocks have an owner.</b> The read pays Paul.</p></div><div class="gc gain"><span class="sign">+</span><span>Every paid block has an owner. Reads of <code>pool_list</code> inside a swap window pay the buyer.</span></div><div class="gc cost"><span class="sign">−</span><span>A new money rule in two crates: one block’s cost splits over two bands.</span></div></section>"`;

exports[`seq view > pins the today view: lanes, ledger, start row, legend, no tags 1`] = `"<section class="view today o-a"><div class="vhead"><span class="lt">a</span><div class="vtt"><span class="vt">Keep one band per paid block, as ruled in 6.5</span><span class="vmeta"><span class="star">★ my pick</span> · <span>as today</span></span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 350" style="min-width:760px" role="img" aria-label="Today 10 paid leaf blocks have no owner. A read of them pays no holder."><rect class="ledger-bg" x="784" y="8" width="336" height="336" rx="4"/><line class="life" x1="177" y1="56" x2="177" y2="342"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="342"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="342"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="342"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g><text class="num" x="14" y="122" text-anchor="middle">1</text><g class="e k-money"><line x1="177" y1="118" x2="343" y2="118"/><polygon class="head" points="347,118 338,113 338,123"/><text x="262" y="110" text-anchor="middle">pays 2,400 for the reader [40, 50)</text><text class="sub" x="262" y="134" text-anchor="middle">20 blocks: [30, 50)</text></g></g><g><text class="num" x="14" y="176" text-anchor="middle">2</text><g class="e k-store"><line x1="347" y1="172" x2="513" y2="172"/><polygon class="head" points="517,172 508,167 508,177"/><text x="432" y="164" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="188" text-anchor="middle">band only below the window: [30, 40)</text></g></g><text class="bal chg" x="844" y="176" text-anchor="middle">10</text><text class="bal chg" x="952" y="176" text-anchor="middle">10</text><text class="bal" x="1060" y="176" text-anchor="middle">0</text><g><text class="num" x="14" y="230" text-anchor="middle">3</text><g class="e k-store"><line x1="347" y1="226" x2="513" y2="226"/><polygon class="head" points="517,226 508,221 508,231"/><text x="432" y="218" text-anchor="middle">reader rows land [40, 50)</text><text class="sub" x="432" y="242" text-anchor="middle">band: reader [40, 50)</text></g></g><g><text class="num" x="14" y="284" text-anchor="middle">4</text><g class="e k-money"><line x1="687" y1="280" x2="351" y2="280"/><polygon class="head" points="347,280 356,275 356,285"/><text x="517" y="272" text-anchor="middle">reads leaf rows [40, 50) and pays</text></g></g><g><text class="num" x="14" y="324" text-anchor="middle">5</text><g class="self k-money"><rect x="194.4" y="307" width="305.2" height="26" rx="13"/><text x="347" y="324" text-anchor="middle">holder half: no band, the protocol keeps it</text></g></g><text class="bal" x="844" y="324" text-anchor="middle">10</text><text class="bal" x="952" y="324" text-anchor="middle">10</text><text class="bal" x="1060" y="324" text-anchor="middle">0</text></svg></div><p class="cap"><b>Today 10 paid leaf blocks have no owner.</b> A read of them pays no holder.</p></div><div class="gc gain"><span class="sign">+</span><span>No money rule changes. The four 6.5b tests stay.</span></div><div class="gc cost"><span class="sign">−</span><span>The stake stays. The plan records the gap.</span></div></section>"`;
