// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the emitted page > pins the example full HTML 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PR 251 rulings</title>
<style>

:root {
  --paper: #eceee9; --sheet: #fbfbf9; --ink: #1b2130; --muted: #5d6573; --rule: #d7dad1; --code: #f1f2ee;
  --add: #1a7f37; --del: #cf222e; --k-call: #1b2130; --k-money: #a15c07; --k-store: #0b7285; --k-check: #6b7280; --k-fail: #c92a2a;
  --tk-kw: #7048b6; --tk-str: #2f7d4f; --tk-com: #87907e; --tk-num: #a15c07; --tk-fn: #1c66c9; --tk-cls: #0b7285;
  --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
  --display: "Iowan Old Style", "Century Schoolbook", C059, Georgia, serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --t: 20px; --b: 14px; --s: 12.5px;
  --r: 8px; --r-s: 4px;
  --measure: 65ch;
  --gap-s: 16px; --gap-m: 24px; --gap-l: 40px;
  --side: 228px;
  --o: var(--ink);
}

* { box-sizing: border-box; }
html { background: var(--paper); scroll-behavior: smooth; }
body { margin: 0; background: var(--paper); color: var(--ink); font: var(--b)/1.55 var(--sans); }
h1, h2, h3, p { margin: 0; }
b, strong { font-weight: 500; }
code { font-family: var(--mono); background: var(--code); padding: 0 4px; border-radius: var(--r-s); overflow-wrap: anywhere; }
button { font: inherit; color: inherit; background: none; border: 0; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } html { scroll-behavior: auto; } }

.side { position: fixed; inset: 0 auto 0 0; width: var(--side); padding: 20px 14px 96px; border-right: 1px solid var(--rule); overflow-y: auto; overscroll-behavior: contain; font-size: var(--s); }
.layout { display: flex; gap: 2px; padding: 2px; margin-bottom: 18px; border: 1px solid var(--rule); border-radius: var(--r); }
.layout button { flex: 1; padding: 4px 0; border-radius: var(--r-s); color: var(--muted); cursor: pointer; }
.layout button[aria-pressed="true"] { background: var(--sheet); color: var(--ink); font-weight: 500; }
.scount { display: block; color: var(--muted); text-decoration: none; padding: 0 8px 12px; }
.sg { margin-bottom: 14px; }
.sg h2 { display: flex; justify-content: space-between; padding: 0 8px 4px; font: 500 var(--s) var(--sans); color: var(--muted); }
.rl { display: flex; gap: 8px; align-items: baseline; padding: 4px 8px; border-radius: var(--r-s); color: var(--muted); text-decoration: none; }
.rl .gid { flex: none; font-family: var(--mono); }
.rl .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rl:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 5%, transparent); }
.rl.here { color: var(--ink); background: var(--sheet); }
.rl.merged .t { font-style: italic; }
.rl.ruled { color: var(--ink); }
.rl.ruled::after { content: "✓"; margin-left: auto; flex: none; color: var(--add); }

.where { position: fixed; top: 10px; left: 50%; transform: translateX(-50%); z-index: 9; display: none; max-width: calc(100vw - 24px); padding: 6px 14px; border: 1px solid var(--rule); border-radius: var(--r); background: var(--sheet); color: var(--ink); font-size: var(--s); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-shadow: 0 6px 24px color-mix(in srgb, var(--ink) 12%, transparent); }

.doc { margin-left: var(--side); }
.doc-in { max-width: 1240px; margin: 0 auto; padding: 32px 32px var(--gap-l); }
.mast { max-width: var(--measure); }
.eyebrow { font-size: var(--s); color: var(--muted); }
.mast h1 { font: 600 26px/1.3 var(--display); margin-top: 4px; }
.mast .sub { color: var(--muted); margin-top: 4px; }
.notes { max-width: var(--measure); margin-top: var(--gap-s); display: grid; gap: 6px; color: var(--muted); }
.note b { color: var(--ink); }

.ghead { display: flex; gap: 14px; align-items: center; margin-top: var(--gap-l); padding-top: 12px; border-top: 1px solid var(--rule); }
.notes + .ghead { margin-top: var(--gap-m); }
.ghead h2 { font: 500 var(--s) var(--sans); color: var(--muted); }
.ghead .quick { padding: 3px 10px; border: 1px solid var(--rule); border-radius: var(--r-s); background: var(--sheet); font-size: var(--s); cursor: pointer; }
.ghead .quick:hover { border-color: var(--ink); }

.ruling { display: grid; grid-template-columns: 40px minmax(0, 1fr); margin-top: var(--gap-l); scroll-margin-top: var(--gap-s); }
.ghead + .ruling { margin-top: var(--gap-s); }
.ruling > * { grid-column: 2; max-width: var(--measure); }
.ruling > .rid { grid-column: 1; font: 500 var(--s)/28px var(--mono); color: var(--muted); }
.ruling > .decide { grid-column: 1 / -1; max-width: none; }
.ruling h3 { font: 600 var(--t)/1.4 var(--display); text-wrap: balance; }
.lede { margin-top: 8px; color: var(--muted); text-wrap: pretty; }
.lede .stake, .lede b { color: var(--ink); }

.decide { margin-top: var(--gap-s); display: grid; grid-template-columns: minmax(300px, 2fr) minmax(0, 3fr); background: var(--sheet); border-radius: var(--r); }
.opts { display: flex; flex-direction: column; gap: 2px; padding: 8px; min-width: 0; align-self: start; position: sticky; top: var(--gap-s); }
.view { min-width: 0; }
.vw { position: sticky; top: var(--gap-s); }
.decide:is(.wide, .bare, .stacked .decide) { grid-template-columns: minmax(0, 1fr); }
.decide:is(.wide, .bare, .stacked .decide) :is(.vw, .opts) { position: static; }

.opt { position: relative; display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 2px 12px; padding: 10px 12px; border-radius: var(--r); cursor: pointer; }
.opt > :not(.disc) { grid-column: 2; }
.opt > input { position: absolute; opacity: 0; margin: 0; }
.opt:hover { background: color-mix(in srgb, var(--ink) 4%, transparent); }
.opt.looked { background: color-mix(in srgb, var(--o) 9%, transparent); }
.opt input:checked + .disc { background: var(--o); color: var(--sheet); }
.opt:has(input:focus-visible) { outline: 2px solid var(--o); outline-offset: -2px; }
button.opt { text-align: left; }
.ot { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
.ot-t { font-weight: 500; }
.tag { padding: 0 6px; border: 1px solid var(--rule); border-radius: var(--r-s); background: var(--paper); font-size: var(--s); color: var(--muted); white-space: nowrap; }
.tag.rec { color: var(--ink); border-color: var(--ink); font-weight: 500; }
.unmet .tag.need { color: var(--ink); text-decoration: underline dotted; text-underline-offset: 3px; }
.g, .c, .w { font-size: var(--s); }
.g::before { content: "+ "; color: var(--add); font-weight: 500; }
.c { color: var(--muted); }
.c::before { content: "− "; font-weight: 500; }
.w { color: var(--muted); font-style: italic; }
@media (min-width: 980px) {
  .decide:is(.wide, .bare, .stacked .decide) .opt { grid-template-columns: 28px minmax(0, 1fr) minmax(0, 1fr); }
  .decide:is(.wide, .bare, .stacked .decide) .opt > :is(.ot, .w) { grid-column: 2 / -1; }
  .decide:is(.wide, .bare, .stacked .decide) .opt > .c { grid-column: 3; }
}

.disc { width: 28px; height: 28px; display: inline-grid; place-items: center; align-self: start; border: 1.5px solid var(--o); border-radius: 50%; color: var(--o); font: 500 var(--s) var(--mono); }
.rfoot { grid-column: 1 / -1; padding: 12px 20px; }
.rnote { display: block; width: 100%; resize: vertical; padding: 5px 0; border: 0; border-bottom: 1px solid var(--rule); background: none; color: var(--ink); font: var(--s)/1.5 var(--sans); }
.rnote:focus { outline: none; border-bottom-color: var(--ink); }
.rnote::placeholder { color: var(--muted); }

.vw { padding: 18px 20px 20px; }
.vh { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; align-items: center; }

.vcap { color: var(--muted); }
.vcap b { color: var(--ink); }
.pic { margin: 16px 0 0 40px; min-width: 0; }
.pic .scroll { overflow-x: auto; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; padding-bottom: 8px; font-size: var(--s); color: var(--muted); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 18px; height: 0; border-top: 2.5px solid var(--k); }
.legend i.dash { border-top-style: dashed; }
.legend .sw { width: 14px; height: 10px; border-radius: 2px; background: color-mix(in srgb, var(--o) 18%, transparent); border: 1px solid var(--o); }
.btag { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-bottom: 6px; font-size: var(--s); color: var(--muted); }
.btag b { color: var(--ink); }
pre { margin: 0; padding: 12px 14px; overflow-x: auto; background: var(--code); border-radius: var(--r); color: var(--ink); font: var(--s)/1.6 var(--mono); white-space: pre; }
pre.diff { padding: 12px 0; }
.fig { overflow-x: auto; }
.fig svg { max-width: 100%; height: auto; }

.dl { display: block; padding: 0 14px 0 26px; position: relative; }
.dl::before { position: absolute; left: 10px; font-weight: 500; }
.dl.add { background: color-mix(in srgb, var(--add) 16%, transparent); }
.dl.add::before { content: "+"; color: var(--add); }
.dl.del { background: color-mix(in srgb, var(--del) 14%, transparent); }
.dl.del::before { content: "−"; color: var(--del); }
.dl.same { opacity: 0.72; }
.token.keyword, .token.boolean, .token.constant, .token.important, .token.tag { color: var(--tk-kw); }
.token.string, .token.char, .token.attr-value, .token.regex { color: var(--tk-str); }
.token.comment, .token.prolog, .token.doctype, .token.cdata { color: var(--tk-com); font-style: italic; }
.token.number, .token.symbol, .token.attr-name { color: var(--tk-num); }
.token.function, .token.method { color: var(--tk-fn); }
.token.class-name, .token.maybe-class-name { color: var(--tk-cls); }

svg.seq { display: block; margin-inline: auto; font-family: var(--sans); color: var(--ink); }
svg text { fill: currentColor; font-size: var(--s); }
.life { stroke: var(--rule); stroke-width: 1.2; }
.actor rect { fill: color-mix(in srgb, var(--ink) 8%, var(--sheet)); stroke: var(--ink); stroke-width: 1.2; }
.actor text { font-weight: 500; font-size: 13px; }
.num { font: 500 11px var(--sans); fill: var(--muted); }
.e line { stroke-width: 1.8; fill: none; }
text.sub { font-size: 11px; fill: var(--muted); }
.k-call { color: var(--k-call); } .k-call line { stroke: var(--k-call); }
.k-money { color: var(--k-money); } .k-money line { stroke: var(--k-money); }
.k-store { color: var(--k-store); } .k-store line { stroke: var(--k-store); stroke-width: 2.6; }
.k-check { color: var(--k-check); } .k-check line { stroke: var(--k-check); stroke-dasharray: 5 4; }
.k-fail { color: var(--k-fail); } .k-fail line { stroke: var(--k-fail); }
.head { fill: currentColor; }
.self rect { fill: var(--sheet); stroke: currentColor; stroke-width: 1.5; }
.ledger-bg { fill: var(--paper); }
.balh { font: 500 11px var(--sans); fill: var(--muted); }
.bal { font: var(--s) var(--mono); fill: var(--muted); }
.bal.chg { font-weight: 500; fill: var(--ink); }
.band { fill: color-mix(in srgb, var(--o) 13%, transparent); }
.tg rect { fill: var(--paper); stroke: var(--o); stroke-width: 1.3; }
.tg text { font: 500 11px var(--sans); fill: var(--o); }
.tg-gone rect { stroke: var(--muted); } .tg-gone text { fill: var(--muted); }
.ghostrule { stroke: var(--rule); stroke-width: 1.2; stroke-dasharray: 4 4; }
.ghosttag { font: 500 11px var(--mono); fill: var(--muted); }
.gone { opacity: 0.42; }
.strike { stroke: var(--o); stroke-width: 1.6; }
svg text.note { font-size: 11px; font-weight: 500; fill: var(--o); }

.composer { max-width: var(--measure); margin-top: var(--gap-l); display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.composer textarea { flex: 1 1 240px; min-width: 150px; min-height: 32px; resize: vertical; padding: 7px 10px; border: 1px solid var(--rule); border-radius: var(--r-s); background: var(--sheet); color: var(--ink); font: var(--s) var(--sans); }
.composer textarea:focus { outline: none; border-color: var(--ink); }
.composer .go { flex: none; padding: 8px 14px; border-radius: var(--r-s); background: var(--ink); color: var(--sheet); font-weight: 600; font-size: var(--s); cursor: pointer; white-space: nowrap; }
.composer .go:disabled { opacity: 0.4; cursor: default; }
.chips { flex: 1 1 200px; min-width: 0; display: flex; flex-wrap: wrap; gap: 6px; }
.chips .empty { color: var(--muted); font-size: var(--s); padding: 4px 0; }
.chip { display: inline-flex; align-items: center; gap: 6px; padding: 2px 4px 2px 8px; border: 1px solid var(--rule); border-radius: var(--r-s); background: var(--paper); font: var(--s) var(--mono); }
.chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--o); }
.chip .need { color: var(--muted); font-family: var(--sans); }
.chip.unmet .need { color: var(--ink); text-decoration: underline dotted; }
.chip .x { color: var(--muted); padding: 0 4px; cursor: pointer; }
.chip .x:hover { color: var(--ink); }

@media (max-width: 979px) {
  .side { display: none; }
  .doc { margin-left: 0; }
  .doc-in { padding: 20px 16px var(--gap-m); }
  .ruling { grid-template-columns: 32px minmax(0, 1fr); scroll-margin-top: 54px; }
  .decide { grid-template-columns: minmax(0, 1fr); }
  .vw, .opts { position: static; }
  .where:not([hidden]) { display: block; }
}
@media (max-width: 640px) {
  .vw { padding: 16px 14px; }
  .pic { margin-left: 0; }
}
</style>
</head>
<body data-key="rulings-testril-pr251">
<nav class="side" aria-label="Rulings"><div class="layout" role="group" aria-label="Layout"><button type="button" data-layout="side" aria-pressed="true">Side by side</button><button type="button" data-layout="stacked" aria-pressed="false">Stacked</button></div><a class="scount" id="ruled-count" href="#rulings-composer">0 of 5 ruled</a><div class="sg"><h2><span>What a buyer is owed</span><span>1</span></h2><a class="rl" href="#r-G1"><span class="gid">G1</span><span class="t">Who owns a leaf block inside its reader’s window?</span></a></div><div class="sg"><h2><span>A code change</span><span>1</span></h2><a class="rl" href="#r-G2"><span class="gid">G2</span><span class="t">Should core stop replacing a caller’s exit handler?</span></a></div><div class="sg"><h2><span>What a restart does</span><span>1</span></h2><a class="rl" href="#r-G4"><span class="gid">G4</span><span class="t">Who re-arms a reader’s window after a daemon restart?</span></a></div><div class="sg"><h2><span>What a start refuses</span><span>1</span></h2><a class="rl" href="#r-G5"><span class="gid">G5</span><span class="t">Should the daemon refuse to serve when its start check fails?</span></a></div><div class="sg"><h2><span>What a buyer sees</span><span>1</span></h2><a class="rl" href="#r-G6"><span class="gid">G6</span><span class="t">Does a reader’s receipt show the blocks that paid no owner?</span></a></div><div class="sg"><h2><span>Merged</span><span>1</span></h2><a class="rl merged" href="#r-G3"><span class="gid">G3</span><span class="t">Should the reader’s window mint its own leaf band?</span></a></div></nav>
<a class="where" id="rulings-where" hidden></a>
<main class="doc"><div class="doc-in">
<header class="mast">
<div class="eyebrow">testril, PR 251, native-functions 6</div>
<h1>PR 251 rulings</h1>
<p class="sub">What to do about the review findings that are real. Nothing is written until you rule.</p>
</header>
<div class="notes"><p class="note"><b>Not rulings: two findings are decided.</b> Finding 1 is false: a band opens only on landed blocks (<code>store.rs:332-390</code>). Finding 2 is ruled: dev databases reset.</p></div>
<div class="ghead"><h2>What a buyer is owed</h2><button type="button" class="quick" data-picks="G1a">Accept ★ recommended</button></div><section class="ruling" id="r-G1"><span class="rid">G1</span><h3>Who owns a leaf block inside its reader’s window?</h3><p class="lede"><span class="stake"><b>In every tree, a read of 10 blocks Paul paid for pays no owner, and no surface shows it.</b></span> Paul buys a reader on a leaf. The daemon records an owner for each block it builds, called a <b>band</b>. A read pays half its fee to the band, which stops where the reader’s window starts.</p><div class="decide wide"><div class="opts"><label class="opt" data-pick="G1a" data-look="today"><input type="radio" name="G1" value="a"><span class="disc">a</span><span class="ot"><span class="ot-t">Keep one band per paid block, as ruled in 6.5</span><span class="tag rec">★ recommended</span><span class="tag">as today</span></span><span class="g">No money rule changes. The four 6.5b tests stay.</span><span class="c">The stake stays. The plan records the gap.</span></label><label class="opt" data-pick="G1b" data-look="G1b"><input type="radio" name="G1" value="b"><span class="disc">b</span><span class="ot"><span class="ot-t">The leaf also gets a band inside the window</span></span><span class="g">Every paid block has an owner. Reads of <code>pool_list</code> inside a swap window pay the buyer.</span><span class="c">A new money rule in two crates: one block’s cost splits over two bands.</span></label><label class="opt" data-pick="G1n"><input type="radio" name="G1" value="n"><span class="disc">n</span><span class="ot"><span class="ot-t">None of these fit</span></span></label></div><div class="view"><div class="vw" data-view="today"><div class="vh"><span class="disc">a</span><p class="vcap"><b>Today 10 paid leaf blocks have no owner.</b> A read of them pays no holder.</p></div><div class="pic"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 350" width="1122" height="350" role="img" aria-label="Today 10 paid leaf blocks have no owner. A read of them pays no holder."><rect class="ledger-bg" x="784" y="8" width="336" height="336" rx="4"/><line class="life" x1="177" y1="56" x2="177" y2="342"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="342"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="342"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="342"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g><text class="num" x="14" y="122" text-anchor="middle">1</text><g class="e k-money"><line x1="177" y1="118" x2="343" y2="118"/><polygon class="head" points="347,118 338,113 338,123"/><text x="262" y="110" text-anchor="middle">pays 2,400 for the reader [40, 50)</text><text class="sub" x="262" y="134" text-anchor="middle">20 blocks: [30, 50)</text></g></g><g><text class="num" x="14" y="176" text-anchor="middle">2</text><g class="e k-store"><line x1="347" y1="172" x2="513" y2="172"/><polygon class="head" points="517,172 508,167 508,177"/><text x="432" y="164" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="188" text-anchor="middle">band only below the window: [30, 40)</text></g></g><text class="bal chg" x="844" y="176" text-anchor="middle">10</text><text class="bal chg" x="952" y="176" text-anchor="middle">10</text><text class="bal" x="1060" y="176" text-anchor="middle">0</text><g><text class="num" x="14" y="230" text-anchor="middle">3</text><g class="e k-store"><line x1="347" y1="226" x2="513" y2="226"/><polygon class="head" points="517,226 508,221 508,231"/><text x="432" y="218" text-anchor="middle">reader rows land [40, 50)</text><text class="sub" x="432" y="242" text-anchor="middle">band: reader [40, 50)</text></g></g><g><text class="num" x="14" y="284" text-anchor="middle">4</text><g class="e k-money"><line x1="687" y1="280" x2="351" y2="280"/><polygon class="head" points="347,280 356,275 356,285"/><text x="517" y="272" text-anchor="middle">reads leaf rows [40, 50) and pays</text></g></g><g><text class="num" x="14" y="324" text-anchor="middle">5</text><g class="self k-money"><rect x="194.4" y="307" width="305.2" height="26" rx="13"/><text x="347" y="324" text-anchor="middle">holder half: no band, the protocol keeps it</text></g></g><text class="bal" x="844" y="324" text-anchor="middle">10</text><text class="bal" x="952" y="324" text-anchor="middle">10</text><text class="bal" x="1060" y="324" text-anchor="middle">0</text></svg></div></div></div><div class="vw" data-view="G1b" hidden><div class="vh"><span class="disc">b</span><p class="vcap"><b>All 20 paid leaf blocks have an owner.</b> The read pays Paul.</p></div><div class="pic"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 302" width="1122" height="302" role="img" aria-label="All 20 paid leaf blocks have an owner. The read pays Paul."><rect class="ledger-bg" x="784" y="8" width="336" height="288" rx="4"/><rect class="band" x="4" y="126" width="768" height="66" rx="3"/><rect class="band" x="4" y="252" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="294"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="294"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="294"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="294"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g class="ghost"><text class="num" x="14" y="114" text-anchor="middle">1</text><text class="ghosttag" x="26" y="113.5">as today</text><line class="ghostrule" x1="88.8" y1="110" x2="764" y2="110"/></g><g><text class="num" x="14" y="150" text-anchor="middle">2</text><g class="tg tg-changed"><rect x="26" y="137" width="58" height="18" rx="4"/><text x="55" y="150" text-anchor="middle">changed</text></g><g class="e k-store"><line x1="347" y1="146" x2="513" y2="146"/><polygon class="head" points="517,146 508,141 508,151"/><text x="432" y="138" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="162" text-anchor="middle">bands [30, 40) and [40, 50)</text></g></g><text class="note" x="432" y="176" text-anchor="middle">the in-window blocks get a leaf band too</text><text class="bal chg" x="844" y="150" text-anchor="middle">20</text><text class="bal" x="952" y="150" text-anchor="middle">0</text><text class="bal" x="1060" y="150" text-anchor="middle">0</text><g class="ghost"><text class="num" x="14" y="212" text-anchor="middle">3</text><text class="ghosttag" x="26" y="211.5">as today</text><line class="ghostrule" x1="88.8" y1="208" x2="764" y2="208"/></g><g class="ghost"><text class="num" x="14" y="240" text-anchor="middle">4</text><text class="ghosttag" x="26" y="239.5">as today</text><line class="ghostrule" x1="88.8" y1="236" x2="764" y2="236"/></g><g><text class="num" x="14" y="276" text-anchor="middle">5</text><g class="tg tg-changed"><rect x="26" y="263" width="58" height="18" rx="4"/><text x="55" y="276" text-anchor="middle">changed</text></g><g class="self k-money"><rect x="216.8" y="259" width="260.4" height="26" rx="13"/><text x="347" y="276" text-anchor="middle">holder half goes to Paul’s leaf band</text></g></g><text class="bal" x="844" y="276" text-anchor="middle">20</text><text class="bal" x="952" y="276" text-anchor="middle">0</text><text class="bal chg" x="1060" y="276" text-anchor="middle">½ fee</text></svg></div></div></div></div><div class="rfoot"><textarea class="rnote" data-note="G1" rows="1" placeholder="Note on G1 — what your answer should carry" aria-label="note on G1"></textarea></div></div></section><div class="ghead"><h2>A code change</h2></div><section class="ruling" id="r-G2"><span class="rid">G2</span><h3>Should core stop replacing a caller’s exit handler?</h3><p class="lede"><span class="stake"><b>Every subcommand help request in statusline, tokens and zai prints the root usage and exits 1.</b></span> Every command first runs through core’s <code>parseQuietly</code>, so a bad flag prints no stack trace. It mutes output and calls <code>exitOverride()</code> on each command. That call replaces the handler the caller set.</p><div class="decide"><div class="opts"><button type="button" class="opt" data-look="today" aria-label="Show today’s picture"><span class="disc"></span><span class="ot"><span class="ot-t">Today</span><span class="tag">kept by no option</span></span></button><label class="opt" data-pick="G2a" data-look="G2a" data-needs="G1a"><input type="radio" name="G2" value="a"><span class="disc">a</span><span class="ot"><span class="ot-t">Drop the clobbering exitOverride() call</span><span class="tag rec">★ recommended</span><span class="tag need">needs G1a</span></span><span class="g">The caller’s override fires again; subcommand help prints itself; three red tests pass.</span><span class="c">The silent default override goes; none of the six parseQuietly callers relies on it.</span></label><label class="opt" data-pick="G2b" data-look="G2b"><input type="radio" name="G2" value="b"><span class="disc">b</span><span class="ot"><span class="ot-t">Keep the clobber; classify the error in recover</span></span><span class="w">recover already maps commander error codes to ink replies; this adds one arm — helpDisplayed re-renders the failing command’s own usage instead of the root usage.</span><span class="g">No shared-code change; statusline’s recover learns the helpDisplayed code on its own.</span><span class="c">The trap stays set; every future CLI that installs an override re-learns it.</span></label><label class="opt" data-pick="G2n"><input type="radio" name="G2" value="n"><span class="disc">n</span><span class="ot"><span class="ot-t">None of these fit</span></span></label></div><div class="view"><div class="vw" data-view="today"><div class="vh"><span class="disc"></span><p class="vcap">From <code>core/src/cli.ts:139-189</code>, the walk and its caller. Each option below marks only the lines it changes.</p></div><div class="pic"><div class="btag"><span>built today</span><b>The quiet walk core runs on every command, today.</b></div><pre><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span>
  command<span class="token operator">:</span> Command<span class="token punctuation">,</span>
  <span class="token function-variable function">onUsageError</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span>
<span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span>
  command<span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span>
    <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
    <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  command<span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span>err <span class="token operator">=></span> <span class="token punctuation">{</span>
    <span class="token keyword">const</span> code <span class="token operator">=</span> <span class="token punctuation">(</span>err <span class="token keyword">as</span> <span class="token punctuation">{</span> code<span class="token operator">?</span><span class="token operator">:</span> <span class="token builtin">string</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">.</span>code<span class="token punctuation">;</span>
    <span class="token keyword">if</span> <span class="token punctuation">(</span>code <span class="token operator">===</span> <span class="token string">'commander.help'</span> <span class="token operator">||</span> code <span class="token operator">===</span> <span class="token string">'commander.helpDisplayed'</span><span class="token punctuation">)</span> <span class="token punctuation">{</span>
      <span class="token keyword">throw</span> <span class="token keyword">new</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span>
    <span class="token punctuation">}</span>
    <span class="token function">onUsageError</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span>
    <span class="token keyword">throw</span> err<span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>c <span class="token operator">=></span> <span class="token punctuation">{</span>
    <span class="token function">quiet</span><span class="token punctuation">(</span>c<span class="token punctuation">,</span> onUsageError<span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
<span class="token punctuation">}</span>

<span class="token keyword">export</span> <span class="token keyword">function</span> <span class="token generic-function"><span class="token function">parseCli</span><span class="token generic class-name"><span class="token operator">&lt;</span><span class="token constant">T</span> <span class="token operator">=</span> HelpRequested<span class="token operator">></span></span></span><span class="token punctuation">(</span>
  spec<span class="token operator">:</span> CliSpec<span class="token punctuation">,</span>
  argv<span class="token operator">:</span> <span class="token keyword">readonly</span> <span class="token builtin">string</span><span class="token punctuation">[</span><span class="token punctuation">]</span><span class="token punctuation">,</span>
  onHelp<span class="token operator">?</span><span class="token operator">:</span> CliHelpHook<span class="token operator">&lt;</span><span class="token constant">T</span><span class="token operator">></span><span class="token punctuation">,</span>
  onUsageError<span class="token operator">?</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">,</span> err<span class="token operator">:</span> Error<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span>
<span class="token punctuation">)</span><span class="token operator">:</span> CliInvocation <span class="token operator">|</span> HelpRequested <span class="token operator">|</span> <span class="token constant">T</span> <span class="token operator">|</span> <span class="token keyword">undefined</span> <span class="token punctuation">{</span>
  <span class="token keyword">let</span> invocation<span class="token operator">:</span> CliInvocation <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span>
  <span class="token keyword">const</span> program <span class="token operator">=</span> <span class="token function">materialize</span><span class="token punctuation">(</span>spec<span class="token punctuation">,</span> found <span class="token operator">=></span> <span class="token punctuation">{</span>
    invocation <span class="token operator">=</span> found<span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token keyword">let</span> errored<span class="token operator">:</span> Command <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span>
  <span class="token function">quiet</span><span class="token punctuation">(</span>program<span class="token punctuation">,</span> command <span class="token operator">=></span> <span class="token punctuation">{</span>
    errored <span class="token operator">=</span> command<span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token keyword">try</span> <span class="token punctuation">{</span>
    program<span class="token punctuation">.</span><span class="token function">parse</span><span class="token punctuation">(</span><span class="token punctuation">[</span><span class="token operator">...</span>argv<span class="token punctuation">]</span><span class="token punctuation">,</span> <span class="token punctuation">{</span> from<span class="token operator">:</span> <span class="token string">'user'</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token punctuation">}</span> <span class="token keyword">catch</span> <span class="token punctuation">(</span>err<span class="token punctuation">)</span> <span class="token punctuation">{</span>
    <span class="token keyword">if</span> <span class="token punctuation">(</span><span class="token operator">!</span><span class="token punctuation">(</span>err <span class="token keyword">instanceof</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">)</span><span class="token punctuation">)</span> <span class="token punctuation">{</span>
      <span class="token keyword">if</span> <span class="token punctuation">(</span>errored <span class="token operator">!==</span> <span class="token keyword">undefined</span><span class="token punctuation">)</span> <span class="token punctuation">{</span>
        <span class="token keyword">const</span> cause <span class="token operator">=</span> err <span class="token keyword">instanceof</span> <span class="token class-name">Error</span> <span class="token operator">?</span> err <span class="token operator">:</span> <span class="token keyword">new</span> <span class="token class-name">Error</span><span class="token punctuation">(</span><span class="token function">String</span><span class="token punctuation">(</span>err<span class="token punctuation">)</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
        onUsageError<span class="token operator">?.</span><span class="token punctuation">(</span>errored<span class="token punctuation">,</span> cause<span class="token punctuation">)</span><span class="token punctuation">;</span>
      <span class="token punctuation">}</span>
      <span class="token keyword">return</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span>
    <span class="token punctuation">}</span>
    <span class="token keyword">return</span> onHelp <span class="token operator">!==</span> <span class="token keyword">undefined</span>
      <span class="token operator">?</span> <span class="token function">onHelp</span><span class="token punctuation">(</span>err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">name</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">,</span> err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">helpInformation</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span>
      <span class="token operator">:</span> err<span class="token punctuation">;</span>
  <span class="token punctuation">}</span>
  <span class="token keyword">return</span> invocation<span class="token punctuation">;</span>
<span class="token punctuation">}</span></pre></div></div><div class="vw" data-view="G2a" hidden><div class="vh"><span class="disc">a</span><p class="vcap">Only the exitOverride block is removed; every other line is unchanged.</p></div><div class="pic"><div class="btag"><span>planned</span><span>diff vs today</span></div><pre class="diff"><span class="dl same"><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span></span><span class="dl same">  command<span class="token operator">:</span> Command<span class="token punctuation">,</span></span><span class="dl same">  <span class="token function-variable function">onUsageError</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span></span><span class="dl same"><span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span></span><span class="dl same">  command<span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span></span><span class="dl same">    <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl same">    <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl del">  command<span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span>err <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl del">    <span class="token keyword">const</span> code <span class="token operator">=</span> <span class="token punctuation">(</span>err <span class="token keyword">as</span> <span class="token punctuation">{</span> code<span class="token operator">?</span><span class="token operator">:</span> <span class="token builtin">string</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">.</span>code<span class="token punctuation">;</span></span><span class="dl del">    <span class="token keyword">if</span> <span class="token punctuation">(</span>code <span class="token operator">===</span> <span class="token string">'commander.help'</span> <span class="token operator">||</span> code <span class="token operator">===</span> <span class="token string">'commander.helpDisplayed'</span><span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl del">      <span class="token keyword">throw</span> <span class="token keyword">new</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl del">    <span class="token punctuation">}</span></span><span class="dl del">    <span class="token function">onUsageError</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl del">    <span class="token keyword">throw</span> err<span class="token punctuation">;</span></span><span class="dl del">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>c <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl same">    <span class="token function">quiet</span><span class="token punctuation">(</span>c<span class="token punctuation">,</span> onUsageError<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same"><span class="token punctuation">}</span></span><span class="dl same"></span><span class="dl same"><span class="token keyword">export</span> <span class="token keyword">function</span> <span class="token generic-function"><span class="token function">parseCli</span><span class="token generic class-name"><span class="token operator">&lt;</span><span class="token constant">T</span> <span class="token operator">=</span> HelpRequested<span class="token operator">></span></span></span><span class="token punctuation">(</span></span><span class="dl same">  spec<span class="token operator">:</span> CliSpec<span class="token punctuation">,</span></span><span class="dl same">  argv<span class="token operator">:</span> <span class="token keyword">readonly</span> <span class="token builtin">string</span><span class="token punctuation">[</span><span class="token punctuation">]</span><span class="token punctuation">,</span></span><span class="dl same">  onHelp<span class="token operator">?</span><span class="token operator">:</span> CliHelpHook<span class="token operator">&lt;</span><span class="token constant">T</span><span class="token operator">></span><span class="token punctuation">,</span></span><span class="dl same">  onUsageError<span class="token operator">?</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">,</span> err<span class="token operator">:</span> Error<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span></span><span class="dl same"><span class="token punctuation">)</span><span class="token operator">:</span> CliInvocation <span class="token operator">|</span> HelpRequested <span class="token operator">|</span> <span class="token constant">T</span> <span class="token operator">|</span> <span class="token keyword">undefined</span> <span class="token punctuation">{</span></span><span class="dl same">  <span class="token keyword">let</span> invocation<span class="token operator">:</span> CliInvocation <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token keyword">const</span> program <span class="token operator">=</span> <span class="token function">materialize</span><span class="token punctuation">(</span>spec<span class="token punctuation">,</span> found <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl same">    invocation <span class="token operator">=</span> found<span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token keyword">let</span> errored<span class="token operator">:</span> Command <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token function">quiet</span><span class="token punctuation">(</span>program<span class="token punctuation">,</span> command <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl same">    errored <span class="token operator">=</span> command<span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token keyword">try</span> <span class="token punctuation">{</span></span><span class="dl same">    program<span class="token punctuation">.</span><span class="token function">parse</span><span class="token punctuation">(</span><span class="token punctuation">[</span><span class="token operator">...</span>argv<span class="token punctuation">]</span><span class="token punctuation">,</span> <span class="token punctuation">{</span> from<span class="token operator">:</span> <span class="token string">'user'</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span> <span class="token keyword">catch</span> <span class="token punctuation">(</span>err<span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl same">    <span class="token keyword">if</span> <span class="token punctuation">(</span><span class="token operator">!</span><span class="token punctuation">(</span>err <span class="token keyword">instanceof</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">)</span><span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl same">      <span class="token keyword">if</span> <span class="token punctuation">(</span>errored <span class="token operator">!==</span> <span class="token keyword">undefined</span><span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl same">        <span class="token keyword">const</span> cause <span class="token operator">=</span> err <span class="token keyword">instanceof</span> <span class="token class-name">Error</span> <span class="token operator">?</span> err <span class="token operator">:</span> <span class="token keyword">new</span> <span class="token class-name">Error</span><span class="token punctuation">(</span><span class="token function">String</span><span class="token punctuation">(</span>err<span class="token punctuation">)</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">        onUsageError<span class="token operator">?.</span><span class="token punctuation">(</span>errored<span class="token punctuation">,</span> cause<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">      <span class="token punctuation">}</span></span><span class="dl same">      <span class="token keyword">return</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span></span><span class="dl same">    <span class="token punctuation">}</span></span><span class="dl same">    <span class="token keyword">return</span> onHelp <span class="token operator">!==</span> <span class="token keyword">undefined</span></span><span class="dl same">      <span class="token operator">?</span> <span class="token function">onHelp</span><span class="token punctuation">(</span>err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">name</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">,</span> err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">helpInformation</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span></span><span class="dl same">      <span class="token operator">:</span> err<span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span></span><span class="dl same">  <span class="token keyword">return</span> invocation<span class="token punctuation">;</span></span><span class="dl same"><span class="token punctuation">}</span></span></pre></div></div><div class="vw" data-view="G2b" hidden><div class="vh"><span class="disc">b</span><p class="vcap">Shown whole rather than marked line by line: it is not the same code as today’s walk.</p></div><div class="pic"><div class="btag"><span>sketch — feasibility not checked</span></div><pre>parseQuietly(program, args, err =&gt;
  err instanceof HelpRequested
    ? { help: err.command }
    : commanderCode(err) === &quot;commander.helpDisplayed&quot;
      ? { help: currentCommand(program) }
      : undefined,
)</pre></div></div></div><div class="rfoot"><textarea class="rnote" data-note="G2" rows="1" placeholder="Note on G2 — what your answer should carry" aria-label="note on G2"></textarea></div></div></section><div class="ghead"><h2>What a restart does</h2></div><section class="ruling" id="r-G4"><span class="rid">G4</span><h3>Who re-arms a reader’s window after a daemon restart?</h3><p class="lede"><span class="stake"><b>Roughly 1 daemon restart a week lands mid-read; each one pays a leaf read’s holder half into the void until a human notices.</b></span> The window lives only in the daemon’s memory. After a crash the console shows the reader with no window; whoever is on call reads the ledger, rebuilds the range by hand, and the next read pays the band again.</p><div class="decide wide"><div class="opts"><button type="button" class="opt" data-look="today" aria-label="Show today’s picture"><span class="disc"></span><span class="ot"><span class="ot-t">Today</span><span class="tag">kept by no option</span></span></button><label class="opt" data-pick="G4a" data-look="G4a"><input type="radio" name="G4" value="a"><span class="disc">a</span><span class="ot"><span class="ot-t">The daemon re-arms its windows from Postgres on start</span><span class="tag rec">★ recommended</span></span><span class="g">The window survives a restart; reads never pay into the void and no human is in the loop.</span><span class="c">One more table the daemon owns and migrates; the start sequence grows a step.</span></label><label class="opt" data-pick="G4b" data-look="G4b"><input type="radio" name="G4" value="b"><span class="disc">b</span><span class="ot"><span class="ot-t">The read re-arms the window before paying</span></span><span class="w">The read already opens a transaction on the leaf rows; arming the window there is one more write on the same connection, with no new owner of state.</span><span class="g">The protocol fixes itself; no daemon change at all.</span><span class="c">Every read pays one extra write — about 40 a day at current traffic.</span></label><label class="opt" data-pick="G4n"><input type="radio" name="G4" value="n"><span class="disc">n</span><span class="ot"><span class="ot-t">None of these fit</span></span></label></div><div class="view"><div class="vw" data-view="today"><div class="vh"><span class="disc"></span><p class="vcap"><b>Today a crash loses the window; the read pays into the void until a human rebuilds it.</b></p></div><div class="pic"><div class="legend"><span style="--k:var(--k-call)"><i></i>a call or a reply</span><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span style="--k:var(--k-fail)"><i></i>an error</span></div><div class="scroll"><svg class="seq" viewBox="0 0 906 270" width="906" height="270" role="img" aria-label="Today a crash loses the window; the read pays into the void until a human rebuilds it."><rect class="ledger-bg" x="784" y="8" width="120" height="256" rx="4"/><line class="life" x1="177" y1="56" x2="177" y2="262"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="347" y1="56" x2="347" y2="262"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="517" y1="56" x2="517" y2="262"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Reader</text></g><line class="life" x1="687" y1="56" x2="687" y2="262"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">On call</text></g><text class="balh" x="844" y="32" text-anchor="middle">Windows</text><text class="balh" x="844" y="46" text-anchor="middle">armed</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">1</text><g><text class="num" x="14" y="122" text-anchor="middle">1</text><g class="self k-fail"><rect x="92" y="100" width="311.6" height="36" rx="18"/><text x="247.8" y="115" text-anchor="middle">daemon restarts mid-read</text><text class="sub" x="247.8" y="130" text-anchor="middle">the window lives only in the daemon’s memory</text></g></g><text class="bal chg" x="844" y="122" text-anchor="middle">0</text><g class="ghost"><text class="num" x="14" y="168" text-anchor="middle">2</text><text class="ghosttag" x="26" y="167.5">only in a</text><line class="ghostrule" x1="95.4" y1="164" x2="764" y2="164"/></g><g><text class="num" x="14" y="204" text-anchor="middle">3</text><g class="self k-money"><rect x="364.4" y="187" width="305.2" height="26" rx="13"/><text x="517" y="204" text-anchor="middle">the read pays the holder half into the void</text></g></g><g><text class="num" x="14" y="244" text-anchor="middle">4</text><g class="e k-call"><line x1="687" y1="240" x2="181" y2="240"/><polygon class="head" points="177,240 186,235 186,245"/><text x="432" y="232" text-anchor="middle">a human rebuilds the window from the console</text></g></g><text class="bal chg" x="844" y="244" text-anchor="middle">1</text></svg></div></div></div><div class="vw" data-view="G4a" hidden><div class="vh"><span class="disc">a</span><p class="vcap"><b>The daemon re-arms its windows from Postgres on start.</b> No void window.</p></div><div class="pic"><div class="legend"><span style="--k:var(--k-call)"><i></i>a call or a reply</span><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span style="--k:var(--k-fail)"><i></i>an error</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 906 286" width="906" height="286" role="img" aria-label="The daemon re-arms its windows from Postgres on start. No void window."><rect class="ledger-bg" x="784" y="8" width="120" height="272" rx="4"/><rect class="band" x="4" y="126" width="768" height="50" rx="3"/><rect class="band" x="4" y="180" width="768" height="52" rx="3"/><rect class="band" x="4" y="236" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="278"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="347" y1="56" x2="347" y2="278"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="517" y1="56" x2="517" y2="278"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Reader</text></g><line class="life" x1="687" y1="56" x2="687" y2="278"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">On call</text></g><text class="balh" x="844" y="32" text-anchor="middle">Windows</text><text class="balh" x="844" y="46" text-anchor="middle">armed</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">1</text><g class="ghost"><text class="num" x="14" y="114" text-anchor="middle">1</text><text class="ghosttag" x="26" y="113.5">as today</text><line class="ghostrule" x1="88.8" y1="110" x2="764" y2="110"/></g><g><text class="num" x="14" y="150" text-anchor="middle">2</text><g class="tg tg-new"><rect x="26" y="137" width="58" height="18" rx="4"/><text x="55" y="150" text-anchor="middle">new</text></g><g class="e k-store"><line x1="177" y1="146" x2="343" y2="146"/><polygon class="head" points="347,146 338,141 338,151"/><text x="262" y="138" text-anchor="middle">daemon re-arms the window from Postgres</text><text class="sub" x="262" y="162" text-anchor="middle">one more table the daemon owns</text></g></g><text class="bal chg" x="844" y="150" text-anchor="middle">1</text><g><text class="num" x="14" y="204" text-anchor="middle">3</text><g class="tg tg-changed"><rect x="26" y="191" width="58" height="18" rx="4"/><text x="55" y="204" text-anchor="middle">changed</text></g><g class="self k-money"><rect x="431.6" y="187" width="170.8" height="26" rx="13"/><text x="517" y="204" text-anchor="middle">the read pays the band</text></g></g><text class="note" x="517" y="225" text-anchor="middle">the window survived the restart</text><g class="gone"><text class="num" x="14" y="260" text-anchor="middle">4</text><g class="tg tg-gone"><rect x="26" y="247" width="58" height="18" rx="4"/><text x="55" y="260" text-anchor="middle">gone</text></g><g class="e k-call"><line x1="687" y1="256" x2="181" y2="256"/><polygon class="head" points="177,256 186,251 186,261"/><text x="432" y="248" text-anchor="middle">a human rebuilds the window from the console</text></g><line class="strike" x1="286.8" y1="244" x2="577.2" y2="244"/></g></svg></div></div></div><div class="vw" data-view="G4b" hidden><div class="vh"><span class="disc">b</span><p class="vcap"><b>The read re-arms the window before paying.</b> One extra write per read.</p></div><div class="pic"><div class="legend"><span style="--k:var(--k-call)"><i></i>a call or a reply</span><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span style="--k:var(--k-fail)"><i></i>an error</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 906 260" width="906" height="260" role="img" aria-label="The read re-arms the window before paying. One extra write per read."><rect class="ledger-bg" x="784" y="8" width="120" height="246" rx="4"/><rect class="band" x="4" y="154" width="768" height="52" rx="3"/><rect class="band" x="4" y="210" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="252"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="347" y1="56" x2="347" y2="252"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="517" y1="56" x2="517" y2="252"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Reader</text></g><line class="life" x1="687" y1="56" x2="687" y2="252"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">On call</text></g><text class="balh" x="844" y="32" text-anchor="middle">Windows</text><text class="balh" x="844" y="46" text-anchor="middle">armed</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">1</text><g class="ghost"><text class="num" x="14" y="114" text-anchor="middle">1</text><text class="ghosttag" x="26" y="113.5">as today</text><line class="ghostrule" x1="88.8" y1="110" x2="764" y2="110"/></g><g class="ghost"><text class="num" x="14" y="142" text-anchor="middle">2</text><text class="ghosttag" x="26" y="141.5">only in a</text><line class="ghostrule" x1="95.4" y1="138" x2="764" y2="138"/></g><g><text class="num" x="14" y="178" text-anchor="middle">3</text><g class="tg tg-changed"><rect x="26" y="165" width="58" height="18" rx="4"/><text x="55" y="178" text-anchor="middle">changed</text></g><g class="self k-money"><rect x="351.6" y="161" width="330.8" height="26" rx="13"/><text x="517" y="178" text-anchor="middle">the read re-arms the window, then pays the band</text></g></g><text class="note" x="517" y="199" text-anchor="middle">one extra write per read</text><text class="bal chg" x="844" y="178" text-anchor="middle">1</text><g class="gone"><text class="num" x="14" y="234" text-anchor="middle">4</text><g class="tg tg-gone"><rect x="26" y="221" width="58" height="18" rx="4"/><text x="55" y="234" text-anchor="middle">gone</text></g><g class="e k-call"><line x1="687" y1="230" x2="181" y2="230"/><polygon class="head" points="177,230 186,225 186,235"/><text x="432" y="222" text-anchor="middle">a human rebuilds the window from the console</text></g><line class="strike" x1="286.8" y1="218" x2="577.2" y2="218"/></g></svg></div></div></div></div><div class="rfoot"><textarea class="rnote" data-note="G4" rows="1" placeholder="Note on G4 — what your answer should carry" aria-label="note on G4"></textarea></div></div></section><div class="ghead"><h2>What a start refuses</h2></div><section class="ruling" id="r-G5"><span class="rid">G5</span><h3>Should the daemon refuse to serve when its start check fails?</h3><p class="lede"><span class="stake"><b>Every daemon start runs 1 ledger check whose failure stops nothing: readers pay into a ledger the daemon itself doubted, and a log line is the only sign.</b></span> At start the daemon checks its ledger once and logs a line when the check fails. It serves either way; the check decides nothing.</p><div class="decide bare"><div class="opts"><label class="opt" data-pick="G5a"><input type="radio" name="G5" value="a"><span class="disc">a</span><span class="ot"><span class="ot-t">Refuse to serve when the check fails</span><span class="tag rec">★ recommended</span></span><span class="g">The on-call sees a dead daemon with a reason, not a log line to find.</span><span class="c">One flaky check now stops every read until a human restarts the daemon.</span></label><label class="opt" data-pick="G5b"><input type="radio" name="G5" value="b"><span class="disc">b</span><span class="ot"><span class="ot-t">Keep serving on a failed check</span><span class="tag">as today</span></span><span class="g">Reads continue; a flaky check cannot take the daemon down.</span><span class="c">The only sign of a doubted ledger is a log line nobody is tailing.</span></label><label class="opt" data-pick="G5n"><input type="radio" name="G5" value="n"><span class="disc">n</span><span class="ot"><span class="ot-t">None of these fit</span></span></label></div><div class="rfoot"><textarea class="rnote" data-note="G5" rows="1" placeholder="Note on G5 — what your answer should carry" aria-label="note on G5"></textarea></div></div></section><div class="ghead"><h2>What a buyer sees</h2></div><section class="ruling" id="r-G6"><span class="rid">G6</span><h3>Does a reader’s receipt show the blocks that paid no owner?</h3><p class="lede"><span class="stake"><b>Paul’s receipt for a 2,400 read says 1,200 went to owners and never says why the other half did not.</b></span> A receipt lists the read’s price and what it paid to block owners. Blocks without an owner add nothing to the second line and are not named.</p><div class="decide"><div class="opts"><label class="opt" data-pick="G6a" data-look="G6a"><input type="radio" name="G6" value="a"><span class="disc">a</span><span class="ot"><span class="ot-t">Add an unowned line</span><span class="tag rec">★ recommended</span></span><span class="g">Paul sees which 10 blocks paid nobody, on the receipt Paul already reads.</span><span class="c">Every receipt grows a line, zero on most reads.</span></label><label class="opt" data-pick="G6b" data-look="today"><input type="radio" name="G6" value="b"><span class="disc">b</span><span class="ot"><span class="ot-t">Keep the receipt as it is</span><span class="tag">as today</span></span><span class="g">No receipt change.</span><span class="c">A buyer finds unowned blocks only by asking.</span></label><label class="opt" data-pick="G6n"><input type="radio" name="G6" value="n"><span class="disc">n</span><span class="ot"><span class="ot-t">None of these fit</span></span></label></div><div class="view"><div class="vw" data-view="today"><div class="vh"><span class="disc">b</span><p class="vcap"><b>Today the receipt has no line for the 10 blocks that paid nobody.</b></p></div><div class="pic"><div class="fig"><div style="font: var(--s)/1.5 var(--mono); width: 300px"><div style="font: 500 var(--s) var(--sans); color: var(--muted); padding-bottom: 6px">Receipt</div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule)"><span>Reader [40, 50)</span><span>2,400</span></div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule); color: var(--muted)"><span>Paid to owners</span><span>1,200</span></div></div></div></div></div><div class="vw" data-view="G6a" hidden><div class="vh"><span class="disc">a</span><p class="vcap"><b>The receipt names the 10 blocks that paid nobody.</b></p></div><div class="pic"><div class="fig"><div style="font: var(--s)/1.5 var(--mono); width: 300px"><div style="font: 500 var(--s) var(--sans); color: var(--muted); padding-bottom: 6px">Receipt</div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule)"><span>Reader [40, 50)</span><span>2,400</span></div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule); color: var(--muted)"><span>Paid to owners</span><span>1,200</span></div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule); color: var(--o); font-weight: 500"><span>10 blocks with no owner</span><span>0</span></div></div></div></div></div></div><div class="rfoot"><textarea class="rnote" data-note="G6" rows="1" placeholder="Note on G6 — what your answer should carry" aria-label="note on G6"></textarea></div></div></section><div class="ghead"><h2>Merged</h2></div><section class="ruling" id="r-G3"><span class="rid">G3</span><h3>Should the reader’s window mint its own leaf band?</h3><p class="lede">Merged into G1. Same money question as G1 — whether the window owns its leaf blocks is what option b there rules.</p></section>
<footer class="composer" id="rulings-composer">
<div class="chips" id="picks" aria-live="polite"></div>
<textarea id="rulings-notes" rows="1" placeholder="Page note — anything the answer should carry"></textarea>
<button type="button" class="go" id="copy-answer">Copy answer</button>
</footer>
</div></main>
<script>
(function () {
  'use strict';
  var KEY = document.body.getAttribute('data-key');
  var REF = /^(G\\d+)([a-z])$/;
  function all(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
  function words(s) { return (s || '').split(/\\s+/).filter(Boolean); }
  function store(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function stored(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

  var pickers = all('[data-pick]');
  var sections = all('section.ruling');
  var sum = document.getElementById('picks');
  var notesIn = document.getElementById('rulings-notes');
  var copyBtn = document.getElementById('copy-answer');
  var countEl = document.getElementById('ruled-count');
  var where = document.getElementById('rulings-where');
  var links = {};
  all('.side a.rl').forEach(function (a) { links[a.getAttribute('href').slice(1)] = a; });

  var LIVE = {};
  var ORDER = [];
  pickers.forEach(function (d) {
    var m = REF.exec(d.getAttribute('data-pick'));
    if (!LIVE[m[1]]) { LIVE[m[1]] = {}; ORDER.push(m[1]); }
    LIVE[m[1]][m[2]] = true;
  });
  var pick = {};
  var onotes = {};
  var note = '';

  function load() {
    if (!KEY) return;
    var s;
    try { s = JSON.parse(stored(KEY) || 'null'); } catch (e) { return; }
    if (!s || typeof s !== 'object') return;
    var p = s.picks || {};
    for (var k in p) if (LIVE[k] && LIVE[k][p[k]]) pick[k] = p[k];
    var on = s.onotes || {};
    for (var t in on) if (typeof on[t] === 'string' && LIVE[t]) onotes[t] = on[t];
    if (typeof s.note === 'string') note = s.note;
  }
  function save() {
    if (KEY) store(KEY, JSON.stringify({ picks: pick, onotes: onotes, note: note }));
  }

  function setLayout(v) {
    document.body.classList.toggle('stacked', v === 'stacked');
    all('[data-layout]').forEach(function (b) {
      b.setAttribute('aria-pressed', b.getAttribute('data-layout') === v ? 'true' : 'false');
    });
  }

  function look(section, view) {
    all('.vw', section).forEach(function (w) {
      if (w.getAttribute('data-view') === view) w.removeAttribute('hidden');
      else w.setAttribute('hidden', '');
    });
    all('.opt[data-look]', section).forEach(function (r) {
      var on = r.getAttribute('data-look') === view;
      r.classList.toggle('looked', on);
      if (on) r.setAttribute('aria-current', 'true');
      else r.removeAttribute('aria-current');
    });
  }
  function pickedView(section) {
    var p = pick[section.id.slice(2)];
    var row = p && section.querySelector('.opt[data-look][data-pick="' + section.id.slice(2) + p + '"]');
    return row ? row.getAttribute('data-look') : null;
  }
  function restoreViews(list) {
    list.forEach(function (s) {
      var first = s.querySelector('.vw');
      if (first) look(s, pickedView(s) || first.getAttribute('data-view'));
    });
  }

  function unmet(needs) {
    return needs.filter(function (t) { var m = REF.exec(t); return !m || pick[m[1]] !== m[2]; });
  }
  function entries() {
    return ORDER.filter(function (id) { return pick[id]; }).map(function (id) {
      var row = document.querySelector('[data-pick="' + id + pick[id] + '"]');
      return { label: id + pick[id], rid: id, bad: unmet(words(row.getAttribute('data-needs'))) };
    });
  }

  function render() {
    pickers.forEach(function (d) {
      var m = REF.exec(d.getAttribute('data-pick'));
      var input = d.querySelector('input');
      if (input) input.checked = pick[m[1]] === m[2];
    });
    all('.opt[data-needs]').forEach(function (r) {
      r.classList.toggle('unmet', unmet(words(r.getAttribute('data-needs'))).length > 0);
    });
    var es = entries();
    if (countEl) countEl.textContent = es.length + ' of ' + ORDER.length + ' ruled';
    for (var h in links) links[h].classList.toggle('ruled', !!pick[h.slice(2)]);
    if (!sum) return;
    sum.innerHTML = es.length === 0
      ? '<span class="empty">No picks yet — click an option</span>'
      : es.map(function (e) {
        return '<span class="chip' + (e.bad.length ? ' unmet' : '') + '"><i></i>' + e.label +
          (e.bad.length ? '<span class="need">needs ' + e.bad.join(' ') + '</span>' : '') +
          '<button type="button" class="x" data-unpick="' + e.label + '" aria-label="unpick ' + e.label + '">×</button></span>';
      }).join('');
    if (copyBtn) copyBtn.disabled = answerText() === '';
  }
  function commit() { render(); save(); }
  function endsDragSelect(e) {
    return e.detail > 0 && String(window.getSelection ? window.getSelection() : '') !== '';
  }

  document.addEventListener('click', function (e) {
    var t = e.target;
    var x = t.closest('[data-unpick]');
    if (x) { delete pick[REF.exec(x.getAttribute('data-unpick'))[1]]; commit(); return; }
    var lay = t.closest('[data-layout]');
    if (lay) { setLayout(lay.getAttribute('data-layout')); store('rulings-layout', lay.getAttribute('data-layout')); return; }
    var quick = t.closest('[data-picks]');
    if (quick) {
      words(quick.getAttribute('data-picks')).forEach(function (r) { var m = REF.exec(r); if (m) pick[m[1]] = m[2]; });
      restoreViews(sections);
      commit();
      return;
    }
    var picker = t.closest('[data-pick]');
    if (picker) {
      var input = picker.querySelector('input');
      if (input && endsDragSelect(e)) { e.preventDefault(); return; }
      if (input && t !== input && input.checked) {
        e.preventDefault();
        input.checked = false;
        delete pick[REF.exec(picker.getAttribute('data-pick'))[1]];
        commit();
      }
      if (picker.hasAttribute('data-look')) look(picker.closest('section'), picker.getAttribute('data-look'));
      return;
    }
    if (t.closest('input, textarea, a')) return;
    var row = t.closest('.opt[data-look]');
    if (row) look(row.closest('section'), row.getAttribute('data-look'));
  });
  document.addEventListener('change', function (e) {
    var input = e.target;
    var picker = input.closest && input.closest('[data-pick]');
    if (!picker || input.type !== 'radio') return;
    var m = REF.exec(picker.getAttribute('data-pick'));
    pick[m[1]] = m[2];
    commit();
  });
  function preview(e) {
    var row = e.target.closest && e.target.closest('.opts .opt');
    if (!row) return;
    var section = row.closest('section');
    if (row.hasAttribute('data-look')) look(section, row.getAttribute('data-look'));
    else restoreViews([section]);
  }
  document.addEventListener('mouseover', preview);
  document.addEventListener('focusin', preview);
  all('.opts').forEach(function (list) {
    var section = list.closest('section');
    list.addEventListener('mouseleave', function () { restoreViews([section]); });
    list.addEventListener('focusout', function (e) {
      if (!e.relatedTarget || !list.contains(e.relatedTarget)) restoreViews([section]);
    });
  });

  function sizeNote() {
    notesIn.style.height = 'auto';
    notesIn.style.height = notesIn.scrollHeight + notesIn.offsetHeight - notesIn.clientHeight + 'px';
  }
  if (notesIn) notesIn.addEventListener('input', function () { note = notesIn.value; commit(); sizeNote(); });
  all('.rnote').forEach(function (inp) {
    inp.addEventListener('input', function () { onotes[inp.getAttribute('data-note')] = inp.value; save(); });
  });

  function setWhere(id) {
    if (!where) return;
    if (!id) { where.setAttribute('hidden', ''); return; }
    var l = links['r-' + id];
    where.removeAttribute('hidden');
    where.setAttribute('href', '#r-' + id);
    where.textContent = id + ' · ' + (l ? l.querySelector('.t').textContent : '');
  }
  if ('IntersectionObserver' in window) {
    var here = null;
    var io = new IntersectionObserver(function (ents) {
      ents.forEach(function (en) {
        var l = links[en.target.id];
        if (!l) return;
        if (!en.isIntersecting) {
          l.classList.remove('here');
          if (here === en.target.id) { here = null; setWhere(null); }
          return;
        }
        for (var k in links) links[k].classList.remove('here');
        l.classList.add('here');
        here = en.target.id;
        setWhere(here.slice(2));
      });
    }, { rootMargin: '-12% 0px -78% 0px' });
    sections.forEach(function (s) { io.observe(s); });
  }

  function answerText() {
    var es = entries();
    var line = ORDER.map(function (id) {
      var e = es.filter(function (x) { return x.rid === id; })[0];
      var t = e ? e.label + (e.bad.length ? ' (needs ' + e.bad.join(' ') + ')' : '') : id;
      var n = (onotes[id] || '').trim();
      return n ? t + ' — ' + n : e ? t : '';
    }).filter(Boolean).join(', ');
    var extra = note.trim();
    return extra ? line + '\\n\\n' + extra : line;
  }
  function fallbackCopy(t) {
    var ta = document.createElement('textarea');
    ta.value = t;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    return ok;
  }
  function within(p, ms) {
    return new Promise(function (res) {
      var t = setTimeout(function () { res(false); }, ms);
      p.then(function () { clearTimeout(t); res(true); }, function () { clearTimeout(t); res(false); });
    });
  }
  function say(text) {
    copyBtn.textContent = text;
    setTimeout(function () { copyBtn.textContent = 'Copy answer'; }, 1800);
  }
  if (copyBtn) copyBtn.addEventListener('click', function () {
    var t = answerText();
    var done = function (ok) { say(ok ? 'Copied' : 'Copy failed — copy the summary by hand'); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      within(navigator.clipboard.writeText(t), 1500).then(function (ok) { done(ok || fallbackCopy(t)); });
    } else done(fallbackCopy(t));
  });

  setLayout(stored('rulings-layout') === 'stacked' ? 'stacked' : 'side');
  load();
  restoreViews(sections);
  if (notesIn) { notesIn.value = note; sizeNote(); }
  all('.rnote').forEach(function (inp) { inp.value = onotes[inp.getAttribute('data-note')] || ''; });
  render();
})();
</script>
</body>
</html>
"
`;
