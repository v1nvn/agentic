// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the emitted page > pins the example full HTML: sidebar, sections, views, verdict tails, notes, merged note 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PR 251 rulings</title>
<style>

:root {
  --paper: #eceee9; --sheet: #fbfbf9; --ink: #1b2130; --muted: #5d6573; --rule: #d7dad1; --code: #f1f2ee;
  --opt-a: #3b5bdb; --opt-b: #9c36b5; --opt-c: #c2255c; --opt-d: #2b8a3e;
  --add: #1a7f37; --del: #cf222e; --k-call: #1b2130; --k-money: #a15c07; --k-store: #0b7285; --k-check: #6b7280; --k-fail: #c92a2a;
  --tk-kw: #7048b6; --tk-str: #2f7d4f; --tk-com: #87907e; --tk-num: #a15c07; --tk-fn: #1c66c9; --tk-cls: #0b7285;
  --serif: Georgia, "Times New Roman", serif;
  --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --o: var(--ink);
  --rail: 3px;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --paper: #14171c; --sheet: #1c2027; --ink: #e6e8ec; --muted: #9aa3b1; --rule: #2f3540; --code: #171b21;
    --opt-a: #8ea6ff; --opt-b: #d58beb; --opt-c: #f28bae; --opt-d: #7bd389;
    --add: #3fb950; --del: #f85149; --k-call: #e6e8ec; --k-money: #f2b35b; --k-store: #5cc8da; --k-check: #9aa3b1; --k-fail: #ff8a80;
    --tk-kw: #c3a6ff; --tk-str: #7bd389; --tk-com: #6f7787; --tk-num: #f2b35b; --tk-fn: #8ea6ff; --tk-cls: #5cc8da;
  }
}
.o-a { --o: var(--opt-a); } .o-b { --o: var(--opt-b); } .o-c { --o: var(--opt-c); } .o-d { --o: var(--opt-d); }

* { box-sizing: border-box; }
html { background: var(--paper); }
body { margin: 0; background: var(--paper); color: var(--ink); font: 14.5px/1.55 var(--sans); }
code { font: 0.86em var(--mono); background: var(--code); border: 1px solid var(--rule); padding: 0 4px; border-radius: 3px; overflow-wrap: anywhere; }
h1, h3 { margin: 0; font-family: var(--serif); font-weight: 600; line-height: 1.18; text-wrap: balance; }
h2 { margin: 0; font: 600 12px var(--mono); letter-spacing: 0.08em; color: var(--muted); }
p { margin: 0; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }

/* Layout: fixed sidebar left, one content column. */
.side { position: fixed; top: 0; bottom: 0; left: 0; width: 228px; padding: 22px 14px 90px; border-right: 1px solid var(--rule); background: var(--paper); overflow-y: auto; overscroll-behavior: contain; }
.doc { margin-left: 228px; }
.col-in { max-width: 880px; margin: 0 auto; padding: 0 34px 110px; }
section[id^="r-"] { scroll-margin-top: 14px; }

.masthead { padding-block: 34px 10px; }
.eyebrow { font: 11.5px var(--mono); color: var(--muted); }
.masthead h1 { font-size: 31px; letter-spacing: -0.01em; margin-top: 6px; }
.masthead .sub { color: var(--muted); max-width: 64ch; margin-top: 8px; font-size: 14.5px; }

/* Sidebar navigation */
.side .sg { margin-bottom: 16px; }
.side .sg h2 { padding: 0 8px 5px; display: flex; justify-content: space-between; }
.side .sg h2 .n { letter-spacing: 0; }
.side a.rl { display: flex; gap: 8px; align-items: baseline; padding: 3.5px 8px; border-radius: 5px; text-decoration: none; color: var(--muted); font: 13px/1.35 var(--sans); }
.side a.rl .gid { font: 600 11px var(--mono); color: var(--muted); flex: none; }
.side a.rl .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.side a.rl:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 5%, transparent); }
.side a.rl.here { color: var(--ink); background: var(--sheet); box-shadow: inset var(--rail) 0 0 var(--ink); }
.side a.rl.merged .t { font-style: italic; }

/* Notes: one row per entry, the bold lead-in as its mono marker */
.notes { display: grid; gap: 7px; padding-block: 14px 26px; max-width: 78ch; }
.note { font-size: 13.5px; color: var(--muted); padding-left: 3.2em; text-indent: -3.2em; }
.note b { font: 600 12px var(--mono); color: var(--ink); padding-right: 0.4em; }

/* Group bands */
.ghead { display: flex; gap: 14px; align-items: baseline; border-top: 1px solid var(--rule); margin-top: 44px; padding-top: 12px; }
.ghead:first-of-type { margin-top: 10px; }
.ghead h2 { font-size: 12.5px; color: var(--ink); }
.ghead .n { font: 400 11px var(--mono); color: var(--muted); }

.ruling { padding-block: 30px 6px; }
.rhead { display: flex; gap: 14px; align-items: baseline; }
.rid { font: 700 13px var(--mono); color: var(--muted); flex: none; }
.rhead h3 { font-size: 20.5px; }
.rhead .none-btn { margin-left: auto; font: 600 11.5px var(--mono); color: var(--muted); background: none; border: 1px dashed var(--rule); border-radius: 6px; padding: 3px 10px; cursor: pointer; }
.rhead .none-btn:hover { color: var(--ink); border-color: var(--ink); }
.rhead .none-btn.on { color: var(--sheet); background: var(--muted); border-style: solid; border-color: var(--muted); }
.stake { font: 600 16.5px/1.45 var(--serif); max-width: 62ch; margin-top: 10px; }
p.today { font: 14.5px/1.55 var(--sans); max-width: 68ch; color: var(--muted); margin-top: 8px; }
p.today b { color: var(--ink); }
.changed { border: 1px solid var(--rule); background: var(--sheet); padding: 10px 14px; max-width: 78ch; font-size: 13.5px; border-radius: 8px; margin-top: 10px; }
.meta-line { font: 12px var(--mono); color: var(--muted); margin-top: 3px; }

/* Views: today once, then one card per option, hue-railed */
.views { display: grid; gap: 16px; margin-top: 16px; }
.view { display: flex; flex-direction: column; gap: 9px; min-width: 0; padding-left: 12px; border-left: var(--rail) solid color-mix(in srgb, var(--o) 32%, var(--rule)); }
.view.today { border-left-color: var(--rule); }
.vhead { display: flex; gap: 11px; align-items: center; flex-wrap: wrap; }
.vtt { display: flex; flex-wrap: wrap; gap: 3px 12px; align-items: baseline; min-width: 0; }
.vhead .vt { font: 600 14.5px/1.35 var(--sans); }
.vmeta { font: 12px var(--mono); color: var(--muted); }
.lt { width: 27px; height: 27px; flex: none; border-radius: 50%; display: inline-grid; place-items: center; font: 700 14px var(--mono); color: var(--o); border: 1.5px solid var(--o); background: var(--sheet); }
.star { color: var(--ink); font: 600 12px var(--mono); white-space: nowrap; }
.how { font-size: 13.5px; color: var(--muted); max-width: 78ch; }
.gc { font-size: 13.5px; display: grid; grid-template-columns: 14px 1fr; gap: 0 6px; align-content: start; max-width: 78ch; }
.gc .sign { font: 700 13.5px/1.35 var(--sans); }
.gc.cost .sign { color: var(--muted); }

.stage { background: var(--sheet); border: 1px solid var(--rule); border-radius: 8px; min-width: 0; overflow: hidden; }
.stage .legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font: 11px var(--mono); color: var(--muted); padding: 10px 14px 0; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 20px; height: 0; border-top: 2.5px solid var(--k); }
.legend i.dash { border-top-style: dashed; }
.legend .sw { width: 16px; height: 10px; border-radius: 2px; background: color-mix(in srgb, var(--o) 18%, transparent); border: 1px solid var(--o); }
.stage .scroll { overflow-x: auto; padding: 8px 6px 4px; }
.stage .cap { border-top: 1px solid var(--rule); padding: 10px 14px; font-size: 12.5px; color: var(--muted); }
.stage .cap b { color: var(--ink); font-weight: 600; }
.bodies { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 14px; padding: 14px; }
.body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.body .tag { font: 12px var(--mono); color: var(--muted); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.body .tag .lt { width: 20px; height: 20px; font-size: 11px; }
.body.of-option .tag .lt { background: var(--o); color: var(--sheet); }
.body.is-today { --o: var(--muted); }
.body .tag b { color: var(--ink); font-weight: 600; font-family: var(--sans); font-size: 12.5px; }
pre { margin: 0; background: var(--code); border: 1px solid var(--rule); border-radius: 6px; padding: 12px 14px; overflow-x: auto; color: var(--ink); font: 12.5px/1.55 var(--mono); white-space: pre; overflow-wrap: normal; }
.body .bcap { color: var(--muted); font-size: 12.5px; }
.body .tag .state-chip { border: 1px dashed var(--rule); border-radius: 4px; padding: 0 6px; }
.body .tag .dleg { opacity: 0.75; }
.dl { display: block; padding: 0 10px 0 22px; position: relative; }
.dl::before { position: absolute; left: 8px; font-weight: 600; }
.dl.add { background: color-mix(in srgb, var(--add) 18%, transparent); }
.dl.add::before { content: "+"; color: color-mix(in srgb, var(--add) 60%, var(--ink)); }
.dl.del { background: color-mix(in srgb, var(--del) 16%, transparent); }
.dl.del::before { content: "-"; color: color-mix(in srgb, var(--del) 60%, var(--ink)); }
.dl.ctx { opacity: 0.72; }
.dl.ell { color: var(--muted); font-style: italic; opacity: 0.8; }
pre.diff { padding: 8px 0; }
pre.diff .dl { margin: 0; }
.token.keyword, .token.boolean, .token.constant, .token.important, .token.tag { color: var(--tk-kw); }
.token.string, .token.char, .token.attr-value, .token.regex { color: var(--tk-str); }
.token.comment, .token.prolog, .token.doctype, .token.cdata { color: var(--tk-com); font-style: italic; }
.token.number, .token.symbol, .token.attr-name { color: var(--tk-num); }
.token.function, .token.method { color: var(--tk-fn); }
.token.class-name, .token.maybe-class-name { color: var(--tk-cls); }
.body.of-option pre { border-color: color-mix(in srgb, var(--o) 40%, var(--rule)); }

svg.seq { display: block; max-width: 100%; height: auto; font-family: var(--sans); color: var(--ink); }
svg text { fill: currentColor; font-size: 12.5px; }
.life { stroke: var(--rule); stroke-width: 1.2; }
.actor rect { fill: color-mix(in srgb, var(--ink) 8%, var(--sheet)); stroke: var(--ink); stroke-width: 1.2; }
.actor text { font-weight: 600; font-size: 13px; }
.num { font: 600 11px var(--sans); fill: var(--muted); }
.e line { stroke-width: 1.8; fill: none; }
text.sub { font-size: 11.5px; fill: var(--muted); }
.k-call { color: var(--k-call); } .k-call line { stroke: var(--k-call); }
.k-money { color: var(--k-money); } .k-money line { stroke: var(--k-money); }
.k-store { color: var(--k-store); } .k-store line { stroke: var(--k-store); stroke-width: 2.6; }
.k-check { color: var(--k-check); } .k-check line { stroke: var(--k-check); stroke-dasharray: 5 4; }
.k-fail { color: var(--k-fail); } .k-fail line { stroke: var(--k-fail); }
.head { fill: currentColor; }
.self rect { fill: var(--sheet); stroke: currentColor; stroke-width: 1.5; }
.ledger-bg { fill: var(--paper); }
.balh { font: 600 11px var(--sans); fill: var(--muted); }
.bal { font: 12px var(--mono); fill: var(--muted); }
.bal.chg { font-weight: 600; fill: var(--ink); }
.band { fill: color-mix(in srgb, var(--o) 13%, transparent); }
.tg rect { fill: var(--sheet); stroke: var(--o); stroke-width: 1.3; }
.tg text { font: 600 10.5px var(--sans); fill: var(--o); }
.tg-gone rect { stroke: var(--muted); } .tg-gone text { fill: var(--muted); }
.gone { opacity: 0.42; }
.strike { stroke: var(--o); stroke-width: 1.6; }
svg text.note { font-size: 11.5px; font-weight: 600; fill: var(--o); }

.stage.diagram .mermaid { display: flex; justify-content: center; padding: 14px; overflow-x: auto; }
.stage.diagram .mermaid svg { max-width: 100%; height: auto; }

.view[data-pick] { cursor: pointer; }
.view[data-pick]:hover { border-left-color: var(--o); }
.view[data-pick]:hover .stage { border-color: color-mix(in srgb, var(--o) 55%, var(--rule)); }
.view[data-pick]:hover .lt { border-color: var(--o); box-shadow: 0 0 0 3px color-mix(in srgb, var(--o) 16%, transparent); }
.view[aria-pressed="true"] { border-left-width: 5px; border-left-color: var(--o); }
.view[aria-pressed="true"] .stage { border-color: color-mix(in srgb, var(--o) 70%, var(--rule)); background: color-mix(in srgb, var(--o) 5%, var(--sheet)); }
.view[aria-pressed="true"] .lt { background: var(--o); color: var(--sheet); box-shadow: 0 0 0 3px color-mix(in srgb, var(--o) 22%, transparent); }
.pmark { display: none; font: 700 11.5px var(--mono); color: var(--o); margin-left: auto; white-space: nowrap; }
.view[aria-pressed="true"] .pmark { display: inline; }
.view[data-needs].unmet { border-left-style: dashed; }
.view[data-needs].unmet .pmark { display: none; }
.dep { border: 1px dashed transparent; border-radius: 4px; padding: 0 4px; }
.unmet .dep { color: var(--k-fail); font-weight: 600; border-color: var(--k-fail); }
.onote { margin-top: 2px; font: 12.5px var(--sans); color: var(--ink); background: none; border: 0; border-bottom: 1px dashed var(--rule); padding: 5px 2px 4px; width: min(100%, 420px); }
.onote:focus { outline: none; border-bottom-color: var(--o); }
.onote::placeholder { color: var(--muted); opacity: 0.7; }
.ghead .quick { font: 600 12px var(--mono); color: var(--ink); background: var(--sheet); border: 1px solid var(--rule); border-radius: 999px; padding: 4px 13px; cursor: pointer; }
.ghead .quick:hover { border-color: var(--ink); }

.bar { position: fixed; z-index: 10; bottom: 18px; left: 50%; transform: translateX(calc(-50% + 114px)); width: min(856px, calc(100vw - 228px - 48px)); background: var(--sheet); border: 1px solid var(--rule); border-radius: 12px; box-shadow: 0 8px 28px color-mix(in srgb, var(--ink) 14%, transparent); }
.bar-in { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 10px 12px; }
.chips { flex: 1 1 200px; min-width: 0; display: flex; flex-wrap: wrap; gap: 6px; }
.chips .empty { font: 500 12.5px var(--mono); color: var(--muted); padding: 6px 2px; }
.chip { display: inline-flex; align-items: center; gap: 6px; font: 600 12.5px var(--mono); color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 999px; padding: 3px 6px 3px 4px; }
.chip .d { width: 19px; height: 19px; border-radius: 50%; display: inline-grid; place-items: center; font-size: 11px; font-weight: 700; color: var(--sheet); }
.chip.unmet { border-color: var(--k-fail); }
.chip.unmet .x { color: var(--k-fail); }
.chip .need { font: 500 10.5px var(--mono); color: var(--k-fail); }
.chip .x { border: 0; background: none; color: var(--muted); cursor: pointer; font: 700 13px var(--sans); padding: 0 3px; line-height: 1; }
.chip .x:hover { color: var(--ink); }
.bar textarea { flex: 0 1 260px; min-width: 150px; min-height: 34px; max-height: 120px; resize: vertical; font: 12.5px var(--sans); color: var(--ink); background: var(--paper); border: 1px solid var(--rule); border-radius: 7px; padding: 8px 10px; }
.bar textarea:focus { outline: none; border-color: var(--ink); }
.bar button.go { flex: none; font: 600 13px var(--sans); color: var(--sheet); background: var(--ink); border: 0; border-radius: 7px; padding: 9px 16px; cursor: pointer; }
.bar button.go:hover { opacity: 0.88; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

@media (max-width: 979px) {
  .side { display: none; }
  .doc { margin-left: 0; }
  .bar { left: 12px; right: 12px; transform: none; width: auto; }
}
</style>
</head>
<body data-key="rulings-testril-pr251">
<nav class="side" aria-label="Rulings"><div class="sg"><h2><span>What a buyer is owed</span><span class="n">2</span></h2><a class="rl" href="#r-G1"><span class="gid">G1</span><span class="t">Who owns a leaf block inside its reader’s window?</span></a><a class="rl merged" href="#r-G3"><span class="gid">G3</span><span class="t">Should the reader’s window mint its own leaf band?</span></a></div><div class="sg"><h2><span>A code change</span><span class="n">1</span></h2><a class="rl" href="#r-G2"><span class="gid">G2</span><span class="t">Should core stop replacing a caller’s exit handler?</span></a></div><div class="sg"><h2><span>What a restart does</span><span class="n">1</span></h2><a class="rl" href="#r-G4"><span class="gid">G4</span><span class="t">Who re-arms a reader’s window after a daemon restart?</span></a></div></nav>
<div class="doc">
<main class="col-in">
<div class="masthead">
<div class="eyebrow">testril, PR 251, native-functions 6</div>
<h1>PR 251 rulings</h1>
<p class="sub">What to do about the review findings that are real. Nothing is written until you rule.</p>
</div>
<div class="notes"><div class="note"><b>Not rulings: two findings are decided.</b> Finding 1 is false: a band opens only on landed blocks (<code>store.rs:332-390</code>). Finding 2 is ruled: dev databases reset.</div></div>
<div class="ghead"><h2>What a buyer is owed</h2><button type="button" class="quick" data-picks="G1a">accept ★ recommended</button></div><section class="ruling" id="r-G1"><div class="rhead"><span class="rid">G1</span><div><h3>Who owns a leaf block inside its reader’s window?</h3><button type="button" class="none-btn" data-none="G1">none of these fit · n</button></div></div><div class="changed"><b>G3 is merged into this ruling.</b> Same money question as G1 — whether the window owns its leaf blocks is what option b there rules.</div><p class="stake"><b>In every tree, a read of 10 blocks Paul paid for pays no owner, and no surface shows it.</b></p><p class="today">Paul buys a reader on a leaf. The daemon records an owner for each block it builds, called a <b>band</b>. A read pays half its fee to the band. The leaf’s band stops where the reader’s window starts.</p><div class="views"><section class="view today o-a" data-pick="G1a" role="button" tabindex="0"><div class="vhead"><span class="lt">a</span><div class="vtt"><span class="vt">Keep one band per paid block, as ruled in 6.5</span><span class="vmeta"><span class="star">★ my pick</span> · <span>as today</span></span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 350" style="min-width:760px" role="img" aria-label="Today 10 paid leaf blocks have no owner. A read of them pays no holder."><rect class="ledger-bg" x="784" y="8" width="336" height="336" rx="4"/><line class="life" x1="177" y1="56" x2="177" y2="342"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="342"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="342"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="342"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g><text class="num" x="14" y="122" text-anchor="middle">1</text><g class="e k-money"><line x1="177" y1="118" x2="343" y2="118"/><polygon class="head" points="347,118 338,113 338,123"/><text x="262" y="110" text-anchor="middle">pays 2,400 for the reader [40, 50)</text><text class="sub" x="262" y="134" text-anchor="middle">20 blocks: [30, 50)</text></g></g><g><text class="num" x="14" y="176" text-anchor="middle">2</text><g class="e k-store"><line x1="347" y1="172" x2="513" y2="172"/><polygon class="head" points="517,172 508,167 508,177"/><text x="432" y="164" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="188" text-anchor="middle">band only below the window: [30, 40)</text></g></g><text class="bal chg" x="844" y="176" text-anchor="middle">10</text><text class="bal chg" x="952" y="176" text-anchor="middle">10</text><text class="bal" x="1060" y="176" text-anchor="middle">0</text><g><text class="num" x="14" y="230" text-anchor="middle">3</text><g class="e k-store"><line x1="347" y1="226" x2="513" y2="226"/><polygon class="head" points="517,226 508,221 508,231"/><text x="432" y="218" text-anchor="middle">reader rows land [40, 50)</text><text class="sub" x="432" y="242" text-anchor="middle">band: reader [40, 50)</text></g></g><g><text class="num" x="14" y="284" text-anchor="middle">4</text><g class="e k-money"><line x1="687" y1="280" x2="351" y2="280"/><polygon class="head" points="347,280 356,275 356,285"/><text x="517" y="272" text-anchor="middle">reads leaf rows [40, 50) and pays</text></g></g><g><text class="num" x="14" y="324" text-anchor="middle">5</text><g class="self k-money"><rect x="194.4" y="307" width="305.2" height="26" rx="13"/><text x="347" y="324" text-anchor="middle">holder half: no band, the protocol keeps it</text></g></g><text class="bal" x="844" y="324" text-anchor="middle">10</text><text class="bal" x="952" y="324" text-anchor="middle">10</text><text class="bal" x="1060" y="324" text-anchor="middle">0</text></svg></div><p class="cap"><b>Today 10 paid leaf blocks have no owner.</b> A read of them pays no holder.</p></div><div class="gc gain"><span class="sign">+</span><span>No money rule changes. The four 6.5b tests stay.</span></div><div class="gc cost"><span class="sign">−</span><span>The stake stays. The plan records the gap.</span></div></section><input class="onote" data-note="G1a" placeholder="note for G1a — rides the answer" aria-label="note for G1a"><section class="view o-b" data-pick="G1b" role="button" tabindex="0"><div class="vhead"><span class="lt">b</span><div class="vtt"><span class="vt">The leaf also gets a band inside the window</span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 366" style="min-width:760px" role="img" aria-label="Option b: all 20 paid leaf blocks have an owner. The read pays Paul."><rect class="ledger-bg" x="784" y="8" width="336" height="352" rx="4"/><rect class="band" x="4" y="152" width="768" height="66" rx="3"/><rect class="band" x="4" y="316" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="358"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="358"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="358"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="358"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g><text class="num" x="14" y="122" text-anchor="middle">1</text><g class="e k-money"><line x1="177" y1="118" x2="343" y2="118"/><polygon class="head" points="347,118 338,113 338,123"/><text x="262" y="110" text-anchor="middle">pays 2,400 for the reader [40, 50)</text><text class="sub" x="262" y="134" text-anchor="middle">20 blocks: [30, 50)</text></g></g><g><text class="num" x="14" y="176" text-anchor="middle">2</text><g class="tg tg-changed"><rect x="26" y="163" width="58" height="18" rx="9"/><text x="55" y="176" text-anchor="middle">changed</text></g><g class="e k-store"><line x1="347" y1="172" x2="513" y2="172"/><polygon class="head" points="517,172 508,167 508,177"/><text x="432" y="164" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="188" text-anchor="middle">bands [30, 40) and [40, 50)</text></g></g><text class="note" x="432" y="202" text-anchor="middle">the in-window blocks get a leaf band too</text><text class="bal chg" x="844" y="176" text-anchor="middle">20</text><text class="bal" x="952" y="176" text-anchor="middle">0</text><text class="bal" x="1060" y="176" text-anchor="middle">0</text><g><text class="num" x="14" y="246" text-anchor="middle">3</text><g class="e k-store"><line x1="347" y1="242" x2="513" y2="242"/><polygon class="head" points="517,242 508,237 508,247"/><text x="432" y="234" text-anchor="middle">reader rows land [40, 50)</text><text class="sub" x="432" y="258" text-anchor="middle">band: reader [40, 50)</text></g></g><g><text class="num" x="14" y="300" text-anchor="middle">4</text><g class="e k-money"><line x1="687" y1="296" x2="351" y2="296"/><polygon class="head" points="347,296 356,291 356,301"/><text x="517" y="288" text-anchor="middle">reads leaf rows [40, 50) and pays</text></g></g><g><text class="num" x="14" y="340" text-anchor="middle">5</text><g class="tg tg-changed"><rect x="26" y="327" width="58" height="18" rx="9"/><text x="55" y="340" text-anchor="middle">changed</text></g><g class="self k-money"><rect x="216.8" y="323" width="260.4" height="26" rx="13"/><text x="347" y="340" text-anchor="middle">holder half goes to Paul’s leaf band</text></g></g><text class="bal" x="844" y="340" text-anchor="middle">20</text><text class="bal" x="952" y="340" text-anchor="middle">0</text><text class="bal chg" x="1060" y="340" text-anchor="middle">½ fee</text></svg></div><p class="cap"><b>Option b: all 20 paid leaf blocks have an owner.</b> The read pays Paul.</p></div><div class="gc gain"><span class="sign">+</span><span>Every paid block has an owner. Reads of <code>pool_list</code> inside a swap window pay the buyer.</span></div><div class="gc cost"><span class="sign">−</span><span>A new money rule in two crates: one block’s cost splits over two bands.</span></div></section><input class="onote" data-note="G1b" placeholder="note for G1b — rides the answer" aria-label="note for G1b"></div></section><section class="ruling" id="r-G3"><div class="rhead"><span class="rid">G3</span><div><h3>Should the reader’s window mint its own leaf band?</h3><p class="meta-line">Merged into G1</p></div></div><div class="changed">Same money question as G1 — whether the window owns its leaf blocks is what option b there rules.</div></section><div class="ghead"><h2>A code change</h2></div><section class="ruling" id="r-G2"><div class="rhead"><span class="rid">G2</span><div><h3>Should core stop replacing a caller’s exit handler?</h3><button type="button" class="none-btn" data-none="G2">none of these fit · n</button></div></div><p class="stake"><b>Every subcommand help request in statusline, tokens and zai prints the root usage and exits 1.</b></p><p class="today">Every command first runs through core’s <code>parseQuietly</code>, so a bad flag prints no stack trace. It mutes output and calls <code>exitOverride()</code> on each command. That call replaces the handler the caller set.</p><div class="views"><section class="view today"><div class="vhead"><span class="vt">Today</span><span class="vmeta">how it works now</span></div><div class="stage"><div class="bodies"><div class="body is-today"><div class="tag"><span>built today</span><b>The quiet walk core runs on every command, today.</b></div><pre><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span>
  command
    <span class="token punctuation">.</span><span class="token function">allowExcessArguments</span><span class="token punctuation">(</span><span class="token boolean">false</span><span class="token punctuation">)</span>
    <span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span><span class="token punctuation">)</span>
    <span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span>
      <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
      <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
    <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>quiet<span class="token punctuation">)</span><span class="token punctuation">;</span>
<span class="token punctuation">}</span></pre><p class="bcap">From <code>core/src/cli.ts:8-17</code>. The engine computes and tints the delta against each option.</p></div></div></div></section><section class="view o-a" data-pick="G2a" role="button" tabindex="0" data-needs="G1a"><div class="vhead"><span class="lt">a</span><div class="vtt"><span class="vt">Drop the clobbering exitOverride() call</span><span class="vmeta"><span class="star">★ my pick</span> · <span class="dep">needs G1a</span></span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="bodies"><div class="body of-option"><div class="tag"><span class="lt">a</span><span>planned</span><span class="dleg">diff vs today</span></div><pre class="diff"><span class="dl ctx"><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span></span><span class="dl ctx">  command</span><span class="dl ctx">    <span class="token punctuation">.</span><span class="token function">allowExcessArguments</span><span class="token punctuation">(</span><span class="token boolean">false</span><span class="token punctuation">)</span></span><span class="dl del">    <span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span><span class="token punctuation">)</span></span><span class="dl ctx">    <span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span></span><span class="dl ctx">      <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl ctx">      <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl ctx">    <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl ctx">  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>quiet<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl ctx"><span class="token punctuation">}</span></span></pre><p class="bcap">Write the after-code in full; the engine computes and tints the delta. A long unchanged run collapses on its own.</p></div></div></div><div class="gc gain"><span class="sign">+</span><span>The caller’s override fires again. Subcommand help prints subcommand help; three red tests go green.</span></div><div class="gc cost"><span class="sign">−</span><span>Any caller relying on the silent default override loses it; none exists today, checked across the six parseQuietly callers.</span></div></section><input class="onote" data-note="G2a" placeholder="note for G2a — rides the answer" aria-label="note for G2a"><section class="view o-b" data-pick="G2b" role="button" tabindex="0"><div class="vhead"><span class="lt">b</span><div class="vtt"><span class="vt">Keep the clobber; classify the error in recover</span></div><span class="pmark">✓ picked</span></div><div class="stage"><div class="bodies"><div class="body of-option"><div class="tag"><span class="lt">b</span><span class="state-chip">sketch — feasibility not checked</span></div><pre>parseQuietly(program, args, err =&gt;
  err instanceof HelpRequested
    ? { help: err.command }
    : commanderCode(err) === &quot;commander.helpDisplayed&quot;
      ? { help: currentCommand(program) }
      : undefined,
)</pre><p class="bcap">A sketch: feasibility not checked. diff: false keeps side-by-side snapshots when the pair is not the same code.</p></div></div></div><p class="how">recover already maps commander error codes to ink replies; this adds one arm — helpDisplayed re-renders the failing command’s own usage instead of the root usage.</p><div class="gc gain"><span class="sign">+</span><span>No shared-code change; statusline’s recover learns commander’s helpDisplayed code on its own.</span></div><div class="gc cost"><span class="sign">−</span><span>The trap stays set for the next caller that installs an override. Every future CLI re-learns it.</span></div></section><input class="onote" data-note="G2b" placeholder="note for G2b — rides the answer" aria-label="note for G2b"></div></section><div class="ghead"><h2>What a restart does</h2></div><section class="ruling" id="r-G4"><div class="rhead"><span class="rid">G4</span><div><h3>Who re-arms a reader’s window after a daemon restart?</h3><button type="button" class="none-btn" data-none="G4">none of these fit · n</button></div></div><p class="stake"><b>Roughly 1 daemon restart a week lands mid-read; each one pays a leaf read’s holder half into the void until a human notices.</b></p><p class="today">The window lives only in the daemon’s memory. After a crash the console shows the reader with no window; whoever is on call reads the ledger, rebuilds the range by hand, and the next read pays the band again.</p><div class="views"><section class="view today"><div class="vhead"><span class="vt">Today</span><span class="vmeta">how it works now</span></div><div class="stage diagram"><div class="mermaid">flowchart TD
  R[daemon restarts] --&gt; L[window lost]
  L --&gt; V[read pays the holder half into the void]
  V --&gt; P[a human rebuilds the window from the console]
  P --&gt; A[the read pays the band again]</div><p class="cap"><b>Today a crash loses the window; the read pays into the void until a human rebuilds it.</b></p></div></section><section class="view o-a" data-pick="G4a" role="button" tabindex="0"><div class="vhead"><span class="lt">a</span><div class="vtt"><span class="vt">The daemon re-arms its windows from Postgres on start</span><span class="vmeta"><span class="star">★ my pick</span></span></div><span class="pmark">✓ picked</span></div><div class="stage diagram"><div class="mermaid">flowchart TD
  R[daemon restarts] --&gt; S[daemon reads the window from Postgres]
  S --&gt; A[the read pays the band again]</div><p class="cap"><b>Option a: the daemon re-arms its windows from Postgres on start.</b> No void window.</p></div><div class="gc gain"><span class="sign">+</span><span>A restart becomes a non-event: the window survives, reads never pay into the void, no human in the loop.</span></div><div class="gc cost"><span class="sign">−</span><span>One more table the daemon owns and migrates; the start sequence grows a step.</span></div></section><input class="onote" data-note="G4a" placeholder="note for G4a — rides the answer" aria-label="note for G4a"><section class="view o-b" data-pick="G4b" role="button" tabindex="0"><div class="vhead"><span class="lt">b</span><div class="vtt"><span class="vt">The read re-arms the window before paying</span></div><span class="pmark">✓ picked</span></div><div class="stage diagram"><div class="mermaid">flowchart TD
  R[daemon restarts] --&gt; L[window lost]
  L --&gt; C[the read re-arms the window first]
  C --&gt; A[the read pays the band again]</div><p class="cap"><b>Option b: the read re-arms the window before paying.</b> One extra write per read.</p></div><p class="how">The read already opens a transaction on the leaf rows; arming the window there is one more write on the same connection, with no new owner of state.</p><div class="gc gain"><span class="sign">+</span><span>The protocol fixes itself; no daemon change at all.</span></div><div class="gc cost"><span class="sign">−</span><span>Every read pays one extra write — about 40 a day at current traffic.</span></div></section><input class="onote" data-note="G4b" placeholder="note for G4b — rides the answer" aria-label="note for G4b"></div></section>
</main>
</div>
<footer class="bar">
<div class="bar-in">
<div class="chips" id="picks" aria-live="polite"></div>
<textarea id="rulings-notes" rows="1" placeholder="page note — anything the answer should carry"></textarea>
<button type="button" class="go" id="copy-answer">Copy answer</button>
</div>
</footer>
<script src="mermaid.min.js"></script>
<script>
(function () {
  var nodes = Array.prototype.slice.call(document.querySelectorAll('.mermaid'));
  var src = nodes.map(function (n) { return n.textContent; });
  var mq = window.matchMedia('(prefers-color-scheme: dark)');
  function draw(dark) {
    window.mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default' });
    nodes.forEach(function (n, i) {
      n.textContent = src[i];
      n.removeAttribute('data-processed');
    });
    window.mermaid.run({ querySelector: '.mermaid' });
  }
  draw(mq.matches);
  function flip(e) { draw(e.matches); }
  if (mq.addEventListener) mq.addEventListener('change', flip);
  else if (mq.addListener) mq.addListener(flip);
})();
</script>
<script>
(function () {
  'use strict';
  var KEY = document.body.getAttribute('data-key');
  var REF = /^(G\\d+)([a-z])$/;
  var cards = Array.prototype.slice.call(document.querySelectorAll('[data-pick]'));
  var tracked = Array.prototype.slice.call(document.querySelectorAll('[data-needs]'));
  var noteIns = Array.prototype.slice.call(document.querySelectorAll('.onote'));
  var sum = document.getElementById('picks');
  var notesIn = document.getElementById('rulings-notes');
  var copyBtn = document.getElementById('copy-answer');
  var pick = {};
  var onotes = {};
  var note = '';

  var LIVE = {};
  var CARD = {};
  var ORDER = [];
  cards.forEach(function (c) {
    var m = REF.exec(c.getAttribute('data-pick'));
    if (!m) return;
    if (!LIVE[m[1]]) { LIVE[m[1]] = { n: true }; ORDER.push(m[1]); }
    LIVE[m[1]][m[2]] = true;
    CARD[m[0]] = (c.getAttribute('data-needs') || '').split(/\\s+/).filter(Boolean);
  });

  function load() {
    if (!KEY) return;
    var raw;
    try { raw = localStorage.getItem(KEY); } catch (e) { return; }
    if (!raw) return;
    var s;
    try { s = JSON.parse(raw); } catch (e) { return; }
    if (!s || typeof s !== 'object') return;
    var p = s.picks || {};
    for (var k in p) if (LIVE[k] && typeof p[k] === 'string' && LIVE[k][p[k]]) pick[k] = p[k];
    var on = s.onotes || {};
    for (var t in on) if (typeof on[t] === 'string') onotes[t] = on[t];
    if (typeof s.note === 'string') note = s.note;
    else if (typeof s.notes === 'string') note = s.notes;
  }
  function save() {
    if (!KEY) return;
    try { localStorage.setItem(KEY, JSON.stringify({ picks: pick, onotes: onotes, note: note })); } catch (e) {}
  }
  function unmetOf(list) {
    return list.filter(function (t) {
      var m = REF.exec(t);
      return !m || pick[m[1]] !== m[2];
    });
  }
  function entries() {
    var out = [];
    ORDER.forEach(function (id) {
      if (!pick[id]) return;
      var bad = pick[id] === 'n' ? [] : unmetOf(CARD[id + pick[id]] || []);
      out.push({ label: id + pick[id], bad: bad });
    });
    return out;
  }
  function chipHue(id) {
    var c = document.querySelector('[data-pick="' + id + '"]');
    if (!c) return 'var(--ink)';
    for (var i = 0; i < c.classList.length; i++) {
      if (c.classList[i].indexOf('o-') === 0) return 'var(--opt-' + c.classList[i].slice(2) + ')';
    }
    return 'var(--ink)';
  }
  function render() {
    cards.forEach(function (c) {
      var m = REF.exec(c.getAttribute('data-pick'));
      if (m) c.setAttribute('aria-pressed', pick[m[1]] === m[2] ? 'true' : 'false');
    });
    tracked.forEach(function (el) {
      el.classList.toggle('unmet', unmetOf((el.getAttribute('data-needs') || '').split(/\\s+/).filter(Boolean)).length > 0);
    });
    var noneBtns = document.querySelectorAll('[data-none]');
    for (var i = 0; i < noneBtns.length; i++) {
      var b = noneBtns[i];
      b.classList.toggle('on', pick[b.getAttribute('data-none')] === 'n');
    }
    if (!sum) return;
    var es = entries();
    if (es.length === 0) {
      sum.innerHTML = '<span class="empty">no picks yet — click a view</span>';
      return;
    }
    sum.innerHTML = es.map(function (e) {
      return '<span class="chip' + (e.bad.length ? ' unmet' : '') + '">' +
        '<span class="d" style="background:' + chipHue(e.label) + '">' + e.label.slice(-1) + '</span>' +
        e.label +
        (e.bad.length ? '<span class="need">needs ' + e.bad.join(' ') + '</span>' : '') +
        '<button type="button" class="x" data-unpick="' + e.label + '" aria-label="unpick ' + e.label + '">×</button>' +
        '</span>';
    }).join('');
  }
  function commit() { render(); save(); }

  document.addEventListener('click', function (e) {
    var sel = window.getSelection ? window.getSelection() : null;
    if (sel && String(sel)) return;
    var x = e.target.closest('[data-unpick]');
    if (x) {
      var xm = REF.exec(x.getAttribute('data-unpick'));
      if (xm) delete pick[xm[1]];
      commit();
      return;
    }
    if (e.target.closest('.onote, a, textarea')) return;
    var card = e.target.closest('[data-pick]');
    if (card) {
      var m = REF.exec(card.getAttribute('data-pick'));
      if (m) { if (pick[m[1]] === m[2]) delete pick[m[1]]; else pick[m[1]] = m[2]; }
      commit();
      return;
    }
    var noneBtn = e.target.closest('[data-none]');
    if (noneBtn) {
      var id = noneBtn.getAttribute('data-none');
      if (pick[id] === 'n') delete pick[id]; else pick[id] = 'n';
      commit();
      return;
    }
    var quickBtn = e.target.closest('[data-picks]');
    if (quickBtn) {
      quickBtn.getAttribute('data-picks').split(/\\s+/).filter(Boolean).forEach(function (t) {
        var q = REF.exec(t);
        if (q) pick[q[1]] = q[2];
      });
      commit();
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var card = e.target.closest('[data-pick]');
    if (card) { e.preventDefault(); card.click(); }
  });
  function sizeNote() {
    if (!notesIn) return;
    notesIn.style.height = 'auto';
    notesIn.style.height = notesIn.scrollHeight + 'px';
  }
  if (notesIn) notesIn.addEventListener('input', function () { note = notesIn.value; save(); sizeNote(); });
  noteIns.forEach(function (inp) {
    inp.addEventListener('input', function () { onotes[inp.getAttribute('data-note')] = inp.value; save(); });
  });

  var links = {};
  var sideLinks = document.querySelectorAll('.side a.rl');
  for (var si = 0; si < sideLinks.length; si++) {
    var h = (sideLinks[si].getAttribute('href') || '').slice(1);
    if (h) links[h] = sideLinks[si];
  }
  if ('IntersectionObserver' in window && Object.keys(links).length) {
    var io = new IntersectionObserver(function (ents) {
      ents.forEach(function (en) {
        var l = links[en.target.id];
        if (!l) return;
        if (!en.isIntersecting) { l.classList.remove('here'); return; }
        for (var k in links) links[k].classList.remove('here');
        l.classList.add('here');
      });
    }, { rootMargin: '-12% 0px -78% 0px' });
    var secs = document.querySelectorAll('section[id]');
    for (var sj = 0; sj < secs.length; sj++) io.observe(secs[sj]);
  }

  function answerText() {
    var line = entries().map(function (e) {
      var t = e.label + (e.bad.length ? ' (needs ' + e.bad.join(' ') + ')' : '');
      var n = (onotes[e.label] || '').replace(/^\\s+|\\s+$/g, '');
      return n ? t + ' — ' + n : t;
    }).join(', ');
    var extra = (notesIn ? notesIn.value : note).replace(/^\\s+|\\s+$/g, '');
    return extra ? line + '\\n\\n' + extra : line;
  }
  function fallbackCopy(t) {
    var ta = document.createElement('textarea');
    ta.value = t;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    return ok;
  }
  function within(p, ms) {
    return new Promise(function (res) {
      var over = false;
      var t = setTimeout(function () { if (!over) { over = true; res(false); } }, ms);
      p.then(
        function () { if (!over) { over = true; clearTimeout(t); res(true); } },
        function () { if (!over) { over = true; clearTimeout(t); res(false); } }
      );
    });
  }
  if (copyBtn) copyBtn.addEventListener('click', function () {
    var done = function (ok) {
      copyBtn.textContent = ok ? 'Copied' : 'Copy failed — copy the summary by hand';
      setTimeout(function () { copyBtn.textContent = 'Copy answer'; }, 1800);
    };
    if (entries().length === 0) {
      copyBtn.textContent = 'No picks yet — click a view first';
      setTimeout(function () { copyBtn.textContent = 'Copy answer'; }, 1800);
      return;
    }
    var t = answerText();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      within(navigator.clipboard.writeText(t), 1500).then(function (ok) {
        done(ok ? true : fallbackCopy(t));
      });
    } else done(fallbackCopy(t));
  });

  load();
  if (notesIn) { notesIn.value = note; sizeNote(); }
  noteIns.forEach(function (inp) { inp.value = onotes[inp.getAttribute('data-note')] || ''; });
  render();
})();
</script>
</body>
</html>
"
`;
