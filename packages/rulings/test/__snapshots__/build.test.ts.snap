// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the emitted page > pins the example full HTML 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PR 251 rulings</title>
<style>

:root {
  --paper: #eceee9; --sheet: #fbfbf9; --ink: #1b2130; --muted: #5d6573; --rule: #d7dad1; --code: #f1f2ee;
  --add: #1a7f37; --del: #cf222e; --k-call: #1b2130; --k-money: #a15c07; --k-store: #0b7285; --k-check: #6b7280; --k-fail: #c92a2a;
  --tk-kw: #7048b6; --tk-str: #2f7d4f; --tk-com: #87907e; --tk-num: #a15c07; --tk-fn: #1c66c9; --tk-cls: #0b7285;
  --sans: system-ui, -apple-system, "Segoe UI", sans-serif;
  --display: "Iowan Old Style", "Century Schoolbook", C059, Georgia, serif;
  --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  --t: 22px; --b: 15px; --s: 12.5px;
  --r: 8px; --r-s: 4px;
  --measure: 70ch;
  --gap-s: 16px; --gap-m: 24px; --gap-l: 40px;
  --o: var(--ink);
}

* { box-sizing: border-box; }
html { background: var(--paper); scroll-behavior: smooth; }
body { margin: 0; background: var(--paper); color: var(--ink); font: var(--b)/1.55 var(--sans); }
h1, h2, h3, p { margin: 0; }
b, strong { font-weight: 500; }
code { font-family: var(--mono); background: var(--code); padding: 0 4px; border-radius: var(--r-s); overflow-wrap: anywhere; }
button { font: inherit; color: inherit; background: none; border: 0; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } html { scroll-behavior: auto; } }

.doc { max-width: 1120px; margin: 0 auto; padding: 40px 24px var(--gap-l); }
.mast { max-width: var(--measure); }
.eyebrow { font-size: var(--s); color: var(--muted); }
.mast h1 { font: 600 28px/1.3 var(--display); margin-top: 4px; }
.mast .sub { color: var(--muted); margin-top: 6px; }
.lbl { font: 600 var(--s) var(--sans); color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }

.map { margin-top: var(--gap-m); display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--gap-s) 28px; padding: 16px 18px; background: var(--sheet); border-radius: var(--r); }
.lane { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.chip { display: flex; gap: 8px; align-items: baseline; padding: 6px 10px; border: 1px solid var(--rule); border-radius: 6px; font-size: var(--s); color: var(--muted); text-decoration: none; }
.chip .id { flex: none; font-family: var(--mono); }
.chip.live { border: 1.5px solid var(--ink); color: var(--ink); background: var(--paper); }
.chip.live:hover { background: var(--sheet); }
.chip .got { display: block; color: var(--ink); font-weight: 500; }

.ruling { margin-top: 64px; scroll-margin-top: var(--gap-s); }
.rid { font: 500 var(--s) var(--mono); color: var(--muted); }
.ruling h3 { font: 600 var(--t)/1.35 var(--display); margin-top: 2px; max-width: var(--measure); text-wrap: balance; }
.ruling > p { max-width: var(--measure); }
.stake { margin-top: 8px; }
.changed, .must { margin-top: 10px; }
.changed .lbl, .must .lbl, .because .lbl { margin-right: 8px; }
.cut { margin-top: 4px; font-size: var(--s); color: var(--muted); }
.cut s { color: var(--ink); }
.because { margin-top: var(--gap-s); }
.because i { font-style: normal; border-bottom: 1px solid var(--muted); }

.strip { margin-top: 18px; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 10px; }
.panel { min-width: 0; padding: 12px 12px 10px; background: var(--sheet); border-radius: var(--r); }
.panel.today { background: transparent; border: 1px dashed var(--rule); }
.panel.hov { outline: 1.5px solid var(--ink); }
.ph { display: flex; gap: 8px; align-items: center; font-size: var(--s); font-weight: 600; }
.ph .disc, .vt .disc { width: 20px; height: 20px; font-size: 11px; border-width: 1.2px; }
.fig { margin-top: 8px; overflow-x: auto; }
.fig svg { max-width: 100%; height: auto; }
.pc { margin-top: 6px; font-size: var(--s); color: var(--muted); }
.vcap { margin-top: 18px; color: var(--muted); }
.vcap b { color: var(--ink); }

.stage { margin-top: 18px; padding: 14px 18px 18px; background: var(--sheet); border-radius: var(--r); }
.vtabs { display: flex; flex-wrap: wrap; gap: 6px; }
.vt { display: inline-flex; gap: 6px; align-items: center; padding: 4px 12px; border: 1px solid var(--rule); border-radius: 999px; font-size: var(--s); color: var(--muted); cursor: pointer; }
.vt:hover { border-color: var(--ink); color: var(--ink); }
.vt[aria-pressed="true"] { border-color: var(--ink); color: var(--ink); font-weight: 600; }
.vw .vcap { margin-top: 12px; }
.pic { margin-top: 12px; min-width: 0; }
.pic .scroll { overflow-x: auto; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; padding-bottom: 8px; font-size: var(--s); color: var(--muted); }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 18px; height: 0; border-top: 2.5px solid var(--k); }
.legend i.dash { border-top-style: dashed; }
.legend .sw { width: 14px; height: 10px; border-radius: 2px; background: color-mix(in srgb, var(--o) 18%, transparent); border: 1px solid var(--o); }
.btag { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-bottom: 6px; font-size: var(--s); color: var(--muted); }
.btag b { color: var(--ink); }
pre { margin: 0; padding: 12px 14px; overflow-x: auto; background: var(--code); border-radius: var(--r); color: var(--ink); font: var(--s)/1.6 var(--mono); white-space: pre; }
pre.diff { padding: 12px 0; }
.dl { display: block; padding: 0 14px 0 26px; position: relative; }
.dl::before { position: absolute; left: 10px; font-weight: 500; }
.dl.add { background: color-mix(in srgb, var(--add) 16%, transparent); }
.dl.add::before { content: "+"; color: var(--add); }
.dl.del { background: color-mix(in srgb, var(--del) 14%, transparent); }
.dl.del::before { content: "−"; color: var(--del); }
.dl.same { opacity: 0.72; }
.token.keyword, .token.boolean, .token.constant, .token.important, .token.tag { color: var(--tk-kw); }
.token.string, .token.char, .token.attr-value, .token.regex { color: var(--tk-str); }
.token.comment, .token.prolog, .token.doctype, .token.cdata { color: var(--tk-com); font-style: italic; }
.token.number, .token.symbol, .token.attr-name { color: var(--tk-num); }
.token.function, .token.method { color: var(--tk-fn); }
.token.class-name, .token.maybe-class-name { color: var(--tk-cls); }

svg.seq { display: block; margin-inline: auto; font-family: var(--sans); color: var(--ink); }
svg text { fill: currentColor; font-size: var(--s); }
.life { stroke: var(--rule); stroke-width: 1.2; }
.actor rect { fill: color-mix(in srgb, var(--ink) 8%, var(--sheet)); stroke: var(--ink); stroke-width: 1.2; }
.actor text { font-weight: 500; font-size: 13px; }
.num { font: 500 11px var(--sans); fill: var(--muted); }
.e line { stroke-width: 1.8; fill: none; }
text.sub { font-size: 11px; fill: var(--muted); }
.k-call { color: var(--k-call); } .k-call line { stroke: var(--k-call); }
.k-money { color: var(--k-money); } .k-money line { stroke: var(--k-money); }
.k-store { color: var(--k-store); } .k-store line { stroke: var(--k-store); stroke-width: 2.6; }
.k-check { color: var(--k-check); } .k-check line { stroke: var(--k-check); stroke-dasharray: 5 4; }
.k-fail { color: var(--k-fail); } .k-fail line { stroke: var(--k-fail); }
.head { fill: currentColor; }
.self rect { fill: var(--sheet); stroke: currentColor; stroke-width: 1.5; }
.ledger-bg { fill: var(--paper); }
.balh { font: 500 11px var(--sans); fill: var(--muted); }
.bal { font: var(--s) var(--mono); fill: var(--muted); }
.bal.chg { font-weight: 500; fill: var(--ink); }
.band { fill: color-mix(in srgb, var(--o) 13%, transparent); }
.tg rect { fill: var(--paper); stroke: var(--o); stroke-width: 1.3; }
.tg text { font: 500 11px var(--sans); fill: var(--o); }
.tg-gone rect { stroke: var(--muted); } .tg-gone text { fill: var(--muted); }
.ghostrule { stroke: var(--rule); stroke-width: 1.2; stroke-dasharray: 4 4; }
.ghosttag { font: 500 11px var(--mono); fill: var(--muted); }
.gone { opacity: 0.42; }
.same { opacity: 0.55; }
svg text.was { font-size: 11px; fill: var(--muted); }
.was .old { text-decoration: line-through; }
.strike { stroke: var(--o); stroke-width: 1.6; }
svg text.note { font-size: 11px; font-weight: 500; fill: var(--o); }

.card { margin-top: 14px; padding: 6px 8px 8px; background: var(--sheet); border-radius: var(--r); }
.card .scroll { overflow-x: auto; }
.card table { width: 100%; min-width: calc(220px + var(--n) * 170px); border-collapse: separate; border-spacing: 0; table-layout: fixed; }
.card th, .card td { padding: 9px 12px; vertical-align: top; text-align: left; font-weight: inherit; }
.card thead td:first-child { width: 28%; }
.card thead th { vertical-align: bottom; padding-block: 12px; border-radius: var(--r) var(--r) 0 0; }
.card tbody th { font-weight: 500; border-top: 1px solid var(--rule); }
.card tbody td { border-top: 1px solid var(--rule); }
.card tr.grp th, .card tr.grp td { padding-top: 18px; padding-bottom: 6px; border-top: 0; }
.card tfoot td { padding: 10px 12px 12px; border-radius: 0 0 var(--r) var(--r); }
.card [data-k] { cursor: pointer; }
.card .hov { background: color-mix(in srgb, var(--ink) 4%, transparent); }
.card .picked { background: color-mix(in srgb, var(--ink) 9%, transparent); }
.oh { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: center; }
.ot { font-weight: 600; }
.tags { display: block; }
.tag { display: inline-block; margin: 4px 6px 0 0; padding: 0 6px; border: 1px solid var(--ink); border-radius: var(--r-s); font-size: var(--s); font-weight: 500; white-space: nowrap; }
.tag.quiet { border-color: var(--rule); color: var(--muted); background: var(--paper); }
.disc { width: 28px; height: 28px; flex: none; display: inline-grid; place-items: center; border: 1.5px solid var(--ink); border-radius: 50%; font: 500 var(--s) var(--mono); }
.picked .disc { background: var(--ink); color: var(--sheet); }
.cell { display: flex; gap: 8px; align-items: flex-start; }
.why { font-size: var(--s); color: var(--muted); padding-top: 2px; }
.mk { display: inline-grid; place-items: center; flex: none; width: 22px; height: 22px; border-radius: 50%; font-size: 12px; font-weight: 700; font-style: normal; }
.mk.gain { background: var(--ink); color: var(--sheet); }
.mk.cost { border: 1.5px solid var(--ink); color: var(--ink); }
.mk.mixed { color: var(--muted); font-size: 16px; }
.key { display: flex; flex-wrap: wrap; gap: 6px 18px; padding: 10px 12px 2px; font-size: var(--s); color: var(--muted); }
.key span { display: inline-flex; gap: 6px; align-items: center; }
.key .mk { width: 16px; height: 16px; font-size: 9px; }
.pick { position: relative; display: inline-flex; align-items: center; padding: 6px 14px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--sheet); font-size: var(--s); font-weight: 600; cursor: pointer; }
.pick input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
.pick:has(input:checked) { background: var(--ink); color: var(--sheet); }
.pick:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 2px; }
.pick .on, .pick:has(input:checked) .off { display: none; }
.pick:has(input:checked) .on { display: inline; }
.none { margin-top: 4px; padding: 10px 12px 4px; border-top: 1px solid var(--rule); }
.none .pick { border-color: var(--muted); color: var(--muted); font-weight: 500; }
.none .pick:has(input:checked) { border-color: var(--ink); color: var(--sheet); }
.nlabel { display: block; margin-top: 12px; font-size: var(--s); color: var(--muted); }
.rnote { display: block; width: 100%; max-width: var(--measure); resize: vertical; padding: 5px 0; border: 0; border-bottom: 1px solid var(--rule); background: none; color: var(--ink); font: var(--s)/1.5 var(--sans); }
.rnote:focus { outline: none; border-bottom-color: var(--ink); }

.decided { margin-top: 64px; padding-top: var(--gap-s); border-top: 1px solid var(--rule); max-width: var(--measure); color: var(--muted); }
.decided ul { margin: 8px 0 0; padding-left: 18px; }

.composer { max-width: var(--measure); margin-top: var(--gap-l); display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.rhint { flex: 1 1 100%; font-size: var(--s); color: var(--muted); }
.composer .nlabel { flex: none; margin: 0; }
.composer textarea { flex: 1 1 240px; min-width: 150px; min-height: 32px; resize: vertical; padding: 7px 10px; border: 1px solid var(--rule); border-radius: var(--r-s); background: var(--sheet); color: var(--ink); font: var(--s) var(--sans); }
.composer textarea:focus { outline: none; border-color: var(--ink); }
.composer .go { flex: none; padding: 8px 14px; border-radius: var(--r-s); background: var(--ink); color: var(--sheet); font-weight: 600; font-size: var(--s); cursor: pointer; white-space: nowrap; }
.composer .go:disabled { opacity: 0.4; cursor: default; }
.chips { flex: 1 1 200px; min-width: 0; display: flex; flex-wrap: wrap; gap: 6px; }
.chips .empty { color: var(--muted); font-size: var(--s); padding: 4px 0; }
.chips .chip { display: inline-flex; align-items: center; gap: 6px; padding: 2px 2px 2px 8px; border: 1px solid var(--rule); border-radius: var(--r-s); background: var(--paper); color: var(--ink); font: var(--s) var(--mono); }
.chips .chip i { width: 8px; height: 8px; border-radius: 50%; background: var(--ink); }
.chip .x { width: 32px; height: 32px; display: inline-grid; place-items: center; color: var(--muted); cursor: pointer; }
.chip .x:hover { color: var(--ink); }

@media (max-width: 760px) {
  .doc { padding: 24px 16px var(--gap-m); }
  .strip { grid-template-columns: minmax(0, 1fr); }
}
</style>
</head>
<body data-key="rulings-testril-pr251">
<main class="doc">
<header class="mast">
<div class="eyebrow">testril, PR 251, native-functions 6</div>
<h1>PR 251 rulings</h1>
<p class="sub">What to do about the review findings that are real. Nothing is written until you rule.</p>
</header>
<nav class="map" aria-label="Rulings by round"><div class="lane"><span class="lbl">Rule now</span><a class="chip live" href="#r-G1"><span class="id">G1</span><span>Who owns a leaf block inside its reader’s window?</span></a><a class="chip live" href="#r-G2"><span class="id">G2</span><span>Should core stop replacing a caller’s exit handler?</span></a><a class="chip live" href="#r-G4"><span class="id">G4</span><span>Who re-arms a reader’s window after a daemon restart?</span></a><a class="chip live" href="#r-G5"><span class="id">G5</span><span>Should the daemon refuse to serve when its start check fails?</span></a><a class="chip live" href="#r-G6"><span class="id">G6</span><span>Does a reader’s receipt show the blocks that paid no owner?</span></a></div><div class="lane"><span class="lbl">After G1</span><span class="chip"><span class="id">G3</span><span>How does one block’s cost split over two bands?</span></span></div></nav>
<section class="ruling" id="r-G1"><span class="rid">G1</span><h3>Who owns a leaf block inside its reader’s window?</h3><p class="stake"><b>In every tree, a read of 10 blocks Paul paid for pays no owner, and no surface shows it.</b></p><div class="stage"><div class="vtabs" role="group" aria-label="Picture"><button type="button" class="vt" data-view="today" aria-pressed="true"><span class="disc">a</span>Today</button><button type="button" class="vt" data-view="G1b" aria-pressed="false"><span class="disc">b</span>The leaf also gets a band inside the window</button></div><div class="vw" data-view="today"><p class="vcap"><b>Today 10 paid leaf blocks have no owner.</b> A read of them pays no holder.</p><div class="pic"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 350" width="1122" height="350" role="img" aria-label="Today 10 paid leaf blocks have no owner. A read of them pays no holder."><rect class="ledger-bg" x="784" y="8" width="336" height="336" rx="4"/><line class="life" x1="177" y1="56" x2="177" y2="342"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="342"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="342"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="342"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g><g class="e k-money"><line x1="177" y1="118" x2="343" y2="118"/><polygon class="head" points="347,118 338,113 338,123"/><text x="262" y="110" text-anchor="middle">pays 2,400 for the reader [40, 50)</text><text class="sub" x="262" y="134" text-anchor="middle">20 blocks: [30, 50)</text></g><text class="num" x="14" y="122" text-anchor="middle">1</text></g><g><g class="e k-store"><line x1="347" y1="172" x2="513" y2="172"/><polygon class="head" points="517,172 508,167 508,177"/><text x="432" y="164" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="188" text-anchor="middle">band only below the window: [30, 40)</text></g><text class="num" x="14" y="176" text-anchor="middle">2</text></g><text class="bal chg" x="844" y="176" text-anchor="middle">10</text><text class="bal chg" x="952" y="176" text-anchor="middle">10</text><text class="bal" x="1060" y="176" text-anchor="middle">0</text><g><g class="e k-store"><line x1="347" y1="226" x2="513" y2="226"/><polygon class="head" points="517,226 508,221 508,231"/><text x="432" y="218" text-anchor="middle">reader rows land [40, 50)</text><text class="sub" x="432" y="242" text-anchor="middle">band: reader [40, 50)</text></g><text class="num" x="14" y="230" text-anchor="middle">3</text></g><g><g class="e k-money"><line x1="687" y1="280" x2="351" y2="280"/><polygon class="head" points="347,280 356,275 356,285"/><text x="517" y="272" text-anchor="middle">reads leaf rows [40, 50) and pays</text></g><text class="num" x="14" y="284" text-anchor="middle">4</text></g><g><g class="self k-money"><rect x="194.4" y="307" width="305.2" height="26" rx="13"/><text x="347" y="324" text-anchor="middle">holder half: no band, the protocol keeps it</text></g><text class="num" x="14" y="324" text-anchor="middle">5</text></g><text class="bal" x="844" y="324" text-anchor="middle">10</text><text class="bal" x="952" y="324" text-anchor="middle">10</text><text class="bal" x="1060" y="324" text-anchor="middle">0</text></svg></div></div></div><div class="vw" data-view="G1b" hidden><p class="vcap"><b>All 20 paid leaf blocks have an owner.</b> The read pays Paul.</p><div class="pic"><div class="legend"><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 1122 382" width="1122" height="382" role="img" aria-label="All 20 paid leaf blocks have an owner. The read pays Paul."><rect class="ledger-bg" x="784" y="8" width="336" height="368" rx="4"/><rect class="band" x="4" y="152" width="768" height="66" rx="3"/><rect class="band" x="4" y="316" width="768" height="52" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="374"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Paul</text></g><line class="life" x1="347" y1="56" x2="347" y2="374"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="517" y1="56" x2="517" y2="374"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="687" y1="56" x2="687" y2="374"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">Vineet</text></g><text class="balh" x="844" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="844" y="46" text-anchor="middle">Paul owns</text><text class="balh" x="952" y="32" text-anchor="middle">Leaf blocks</text><text class="balh" x="952" y="46" text-anchor="middle">nobody owns</text><text class="balh" x="1060" y="32" text-anchor="middle">Paul earns</text><text class="balh" x="1060" y="46" text-anchor="middle">from the read</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">0</text><text class="bal" x="952" y="90" text-anchor="middle">0</text><text class="bal" x="1060" y="90" text-anchor="middle">0</text><g class="same"><g class="e k-money"><line x1="177" y1="118" x2="343" y2="118"/><polygon class="head" points="347,118 338,113 338,123"/><text x="262" y="110" text-anchor="middle">pays 2,400 for the reader [40, 50)</text><text class="sub" x="262" y="134" text-anchor="middle">20 blocks: [30, 50)</text></g><text class="num" x="14" y="122" text-anchor="middle">1</text></g><g><g class="e k-store"><line x1="347" y1="172" x2="513" y2="172"/><polygon class="head" points="517,172 508,167 508,177"/><text x="432" y="164" text-anchor="middle">leaf rows land [30, 50)</text><text class="sub" x="432" y="188" text-anchor="middle">bands [30, 40) and [40, 50)</text></g><text class="num" x="14" y="176" text-anchor="middle">2</text><g class="tg tg-changed"><rect x="26" y="163" width="58" height="18" rx="4"/><text x="55" y="176" text-anchor="middle">changed</text></g></g><text class="note" x="432" y="202" text-anchor="middle">the in-window blocks get a leaf band too</text><text class="bal chg" x="844" y="176" text-anchor="middle">20</text><text class="bal" x="952" y="176" text-anchor="middle">0</text><text class="bal" x="1060" y="176" text-anchor="middle">0</text><g class="same"><g class="e k-store"><line x1="347" y1="242" x2="513" y2="242"/><polygon class="head" points="517,242 508,237 508,247"/><text x="432" y="234" text-anchor="middle">reader rows land [40, 50)</text><text class="sub" x="432" y="258" text-anchor="middle">band: reader [40, 50)</text></g><text class="num" x="14" y="246" text-anchor="middle">3</text></g><g class="same"><g class="e k-money"><line x1="687" y1="296" x2="351" y2="296"/><polygon class="head" points="347,296 356,291 356,301"/><text x="517" y="288" text-anchor="middle">reads leaf rows [40, 50) and pays</text></g><text class="num" x="14" y="300" text-anchor="middle">4</text></g><g><g class="self k-money"><rect x="216.8" y="323" width="260.4" height="26" rx="13"/><text x="347" y="340" text-anchor="middle">holder half goes to Paul’s leaf band</text></g><text class="num" x="14" y="340" text-anchor="middle">5</text><g class="tg tg-changed"><rect x="26" y="327" width="58" height="18" rx="4"/><text x="55" y="340" text-anchor="middle">changed</text></g></g><text class="was" x="347" y="361" text-anchor="middle">was <tspan class="old">holder half: no band, the protocol keeps it</tspan></text><text class="bal" x="844" y="340" text-anchor="middle">20</text><text class="bal" x="952" y="340" text-anchor="middle">0</text><text class="bal chg" x="1060" y="340" text-anchor="middle">½ fee</text></svg></div></div></div></div><div class="card" data-ruling="G1"><div class="scroll"><table style="--n:2"><thead><tr><td></td><th scope="col" data-k="a"><div class="oh"><span class="disc">a</span><span><span class="ot">Keep one band per paid block, as ruled in 6.5</span><span class="tags"><span class="tag">recommended</span><span class="tag quiet">as today</span></span></span></div></th><th scope="col" data-k="b"><div class="oh"><span class="disc">b</span><span><span class="ot">The leaf also gets a band inside the window</span></span></div></th></tr></thead><tbody><tr class="grp"><th scope="colgroup"><span class="lbl">On the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">Every paid leaf block has an owner</th><td data-k="a"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">10 of the 20 paid leaf blocks pay no owner; the plan records the gap.</span></div></td><td data-k="b"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">All 20 have an owner; a read inside the window pays Paul.</span></div></td></tr><tr class="grp"><th scope="colgroup"><span class="lbl">Beyond the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">Money rules that change</th><td data-k="a"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">None; the four 6.5b tests stay.</span></div></td><td data-k="b"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">A new rule in two crates: one block’s cost splits over two bands.</span></div></td></tr></tbody><tfoot><tr><td></td><td data-k="a"><label class="pick"><input type="radio" name="G1" value="a" data-pick="G1a"><span class="off">Pick a</span><span class="on">Picked a</span></label></td><td data-k="b"><label class="pick"><input type="radio" name="G1" value="b" data-pick="G1b"><span class="off">Pick b</span><span class="on">Picked b</span></label></td></tr></tfoot></table></div><div class="key"><span><i class="mk gain">✓</i>gain</span><span><i class="mk mixed">–</i>mixed</span><span><i class="mk cost">✕</i>cost</span></div><div class="none" data-k="n"><label class="pick"><input type="radio" name="G1" value="n" data-pick="G1n"><span class="off">None of these fit</span><span class="on">Picked none</span></label></div></div><p class="because"><span class="lbl">Why</span>a, because <i>money rules that change</i> stay at none; it pays in <i>every paid leaf block has an owner</i>.</p><label class="nlabel" for="note-G1">Note on G1</label><textarea class="rnote" id="note-G1" name="note-G1" data-note="G1" rows="1"></textarea></section>
<section class="ruling" id="r-G2"><span class="rid">G2</span><h3>Should core stop replacing a caller’s exit handler?</h3><p class="stake"><b>Every subcommand help request in statusline, tokens and zai prints the root usage and exits 1.</b></p><div class="stage"><div class="vtabs" role="group" aria-label="Picture"><button type="button" class="vt" data-view="today" aria-pressed="true">Today</button><button type="button" class="vt" data-view="G2a" aria-pressed="false"><span class="disc">a</span>Drop the call that replaces the caller’s handler</button><button type="button" class="vt" data-view="G2b" aria-pressed="false"><span class="disc">b</span>Keep it; teach each caller to recognise a help request</button></div><div class="vw" data-view="today"><p class="vcap">The walk core runs on every command, and its caller. Each option marks only the lines it changes.</p><div class="pic"><div class="btag"><span>built today</span><b>The quiet walk core runs on every command, today.</b></div><pre><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span>
  command<span class="token operator">:</span> Command<span class="token punctuation">,</span>
  <span class="token function-variable function">onUsageError</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span>
<span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span>
  command<span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span>
    <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
    <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  command<span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span>err <span class="token operator">=></span> <span class="token punctuation">{</span>
    <span class="token keyword">const</span> code <span class="token operator">=</span> <span class="token punctuation">(</span>err <span class="token keyword">as</span> <span class="token punctuation">{</span> code<span class="token operator">?</span><span class="token operator">:</span> <span class="token builtin">string</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">.</span>code<span class="token punctuation">;</span>
    <span class="token keyword">if</span> <span class="token punctuation">(</span>code <span class="token operator">===</span> <span class="token string">'commander.help'</span> <span class="token operator">||</span> code <span class="token operator">===</span> <span class="token string">'commander.helpDisplayed'</span><span class="token punctuation">)</span> <span class="token punctuation">{</span>
      <span class="token keyword">throw</span> <span class="token keyword">new</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span>
    <span class="token punctuation">}</span>
    <span class="token function">onUsageError</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span>
    <span class="token keyword">throw</span> err<span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>c <span class="token operator">=></span> <span class="token punctuation">{</span>
    <span class="token function">quiet</span><span class="token punctuation">(</span>c<span class="token punctuation">,</span> onUsageError<span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
<span class="token punctuation">}</span>

<span class="token keyword">export</span> <span class="token keyword">function</span> <span class="token generic-function"><span class="token function">parseCli</span><span class="token generic class-name"><span class="token operator">&lt;</span><span class="token constant">T</span> <span class="token operator">=</span> HelpRequested<span class="token operator">></span></span></span><span class="token punctuation">(</span>
  spec<span class="token operator">:</span> CliSpec<span class="token punctuation">,</span>
  argv<span class="token operator">:</span> <span class="token keyword">readonly</span> <span class="token builtin">string</span><span class="token punctuation">[</span><span class="token punctuation">]</span><span class="token punctuation">,</span>
  onHelp<span class="token operator">?</span><span class="token operator">:</span> CliHelpHook<span class="token operator">&lt;</span><span class="token constant">T</span><span class="token operator">></span><span class="token punctuation">,</span>
  onUsageError<span class="token operator">?</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">,</span> err<span class="token operator">:</span> Error<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span>
<span class="token punctuation">)</span><span class="token operator">:</span> CliInvocation <span class="token operator">|</span> HelpRequested <span class="token operator">|</span> <span class="token constant">T</span> <span class="token operator">|</span> <span class="token keyword">undefined</span> <span class="token punctuation">{</span>
  <span class="token keyword">let</span> invocation<span class="token operator">:</span> CliInvocation <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span>
  <span class="token keyword">const</span> program <span class="token operator">=</span> <span class="token function">materialize</span><span class="token punctuation">(</span>spec<span class="token punctuation">,</span> found <span class="token operator">=></span> <span class="token punctuation">{</span>
    invocation <span class="token operator">=</span> found<span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token keyword">let</span> errored<span class="token operator">:</span> Command <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span>
  <span class="token function">quiet</span><span class="token punctuation">(</span>program<span class="token punctuation">,</span> command <span class="token operator">=></span> <span class="token punctuation">{</span>
    errored <span class="token operator">=</span> command<span class="token punctuation">;</span>
  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token keyword">try</span> <span class="token punctuation">{</span>
    program<span class="token punctuation">.</span><span class="token function">parse</span><span class="token punctuation">(</span><span class="token punctuation">[</span><span class="token operator">...</span>argv<span class="token punctuation">]</span><span class="token punctuation">,</span> <span class="token punctuation">{</span> from<span class="token operator">:</span> <span class="token string">'user'</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
  <span class="token punctuation">}</span> <span class="token keyword">catch</span> <span class="token punctuation">(</span>err<span class="token punctuation">)</span> <span class="token punctuation">{</span>
    <span class="token keyword">if</span> <span class="token punctuation">(</span><span class="token operator">!</span><span class="token punctuation">(</span>err <span class="token keyword">instanceof</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">)</span><span class="token punctuation">)</span> <span class="token punctuation">{</span>
      <span class="token keyword">if</span> <span class="token punctuation">(</span>errored <span class="token operator">!==</span> <span class="token keyword">undefined</span><span class="token punctuation">)</span> <span class="token punctuation">{</span>
        <span class="token keyword">const</span> cause <span class="token operator">=</span> err <span class="token keyword">instanceof</span> <span class="token class-name">Error</span> <span class="token operator">?</span> err <span class="token operator">:</span> <span class="token keyword">new</span> <span class="token class-name">Error</span><span class="token punctuation">(</span><span class="token function">String</span><span class="token punctuation">(</span>err<span class="token punctuation">)</span><span class="token punctuation">)</span><span class="token punctuation">;</span>
        onUsageError<span class="token operator">?.</span><span class="token punctuation">(</span>errored<span class="token punctuation">,</span> cause<span class="token punctuation">)</span><span class="token punctuation">;</span>
      <span class="token punctuation">}</span>
      <span class="token keyword">return</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span>
    <span class="token punctuation">}</span>
    <span class="token keyword">return</span> onHelp <span class="token operator">!==</span> <span class="token keyword">undefined</span>
      <span class="token operator">?</span> <span class="token function">onHelp</span><span class="token punctuation">(</span>err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">name</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">,</span> err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">helpInformation</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span>
      <span class="token operator">:</span> err<span class="token punctuation">;</span>
  <span class="token punctuation">}</span>
  <span class="token keyword">return</span> invocation<span class="token punctuation">;</span>
<span class="token punctuation">}</span></pre></div></div><div class="vw" data-view="G2a" hidden><p class="vcap">Only the exitOverride block is removed; every other line is unchanged.</p><div class="pic"><div class="btag"><span>planned</span><span>diff vs today</span></div><pre class="diff"><span class="dl same"><span class="token keyword">function</span> <span class="token function">quiet</span><span class="token punctuation">(</span></span><span class="dl same">  command<span class="token operator">:</span> Command<span class="token punctuation">,</span></span><span class="dl same">  <span class="token function-variable function">onUsageError</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span></span><span class="dl same"><span class="token punctuation">)</span><span class="token operator">:</span> <span class="token keyword">void</span> <span class="token punctuation">{</span></span><span class="dl same">  command<span class="token punctuation">.</span><span class="token function">configureOutput</span><span class="token punctuation">(</span><span class="token punctuation">{</span></span><span class="dl same">    <span class="token function-variable function">writeOut</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl same">    <span class="token function-variable function">writeErr</span><span class="token operator">:</span> <span class="token punctuation">(</span><span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">undefined</span><span class="token punctuation">,</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl del">  command<span class="token punctuation">.</span><span class="token function">exitOverride</span><span class="token punctuation">(</span>err <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl del">    <span class="token keyword">const</span> code <span class="token operator">=</span> <span class="token punctuation">(</span>err <span class="token keyword">as</span> <span class="token punctuation">{</span> code<span class="token operator">?</span><span class="token operator">:</span> <span class="token builtin">string</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">.</span>code<span class="token punctuation">;</span></span><span class="dl del">    <span class="token keyword">if</span> <span class="token punctuation">(</span>code <span class="token operator">===</span> <span class="token string">'commander.help'</span> <span class="token operator">||</span> code <span class="token operator">===</span> <span class="token string">'commander.helpDisplayed'</span><span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl del">      <span class="token keyword">throw</span> <span class="token keyword">new</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl del">    <span class="token punctuation">}</span></span><span class="dl del">    <span class="token function">onUsageError</span><span class="token punctuation">(</span>command<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl del">    <span class="token keyword">throw</span> err<span class="token punctuation">;</span></span><span class="dl del">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  command<span class="token punctuation">.</span>commands<span class="token punctuation">.</span><span class="token function">forEach</span><span class="token punctuation">(</span>c <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl same">    <span class="token function">quiet</span><span class="token punctuation">(</span>c<span class="token punctuation">,</span> onUsageError<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same"><span class="token punctuation">}</span></span><span class="dl same"></span><span class="dl same"><span class="token keyword">export</span> <span class="token keyword">function</span> <span class="token generic-function"><span class="token function">parseCli</span><span class="token generic class-name"><span class="token operator">&lt;</span><span class="token constant">T</span> <span class="token operator">=</span> HelpRequested<span class="token operator">></span></span></span><span class="token punctuation">(</span></span><span class="dl same">  spec<span class="token operator">:</span> CliSpec<span class="token punctuation">,</span></span><span class="dl same">  argv<span class="token operator">:</span> <span class="token keyword">readonly</span> <span class="token builtin">string</span><span class="token punctuation">[</span><span class="token punctuation">]</span><span class="token punctuation">,</span></span><span class="dl same">  onHelp<span class="token operator">?</span><span class="token operator">:</span> CliHelpHook<span class="token operator">&lt;</span><span class="token constant">T</span><span class="token operator">></span><span class="token punctuation">,</span></span><span class="dl same">  onUsageError<span class="token operator">?</span><span class="token operator">:</span> <span class="token punctuation">(</span>command<span class="token operator">:</span> Command<span class="token punctuation">,</span> err<span class="token operator">:</span> Error<span class="token punctuation">)</span> <span class="token operator">=></span> <span class="token keyword">void</span><span class="token punctuation">,</span></span><span class="dl same"><span class="token punctuation">)</span><span class="token operator">:</span> CliInvocation <span class="token operator">|</span> HelpRequested <span class="token operator">|</span> <span class="token constant">T</span> <span class="token operator">|</span> <span class="token keyword">undefined</span> <span class="token punctuation">{</span></span><span class="dl same">  <span class="token keyword">let</span> invocation<span class="token operator">:</span> CliInvocation <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token keyword">const</span> program <span class="token operator">=</span> <span class="token function">materialize</span><span class="token punctuation">(</span>spec<span class="token punctuation">,</span> found <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl same">    invocation <span class="token operator">=</span> found<span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token keyword">let</span> errored<span class="token operator">:</span> Command <span class="token operator">|</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token function">quiet</span><span class="token punctuation">(</span>program<span class="token punctuation">,</span> command <span class="token operator">=></span> <span class="token punctuation">{</span></span><span class="dl same">    errored <span class="token operator">=</span> command<span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token keyword">try</span> <span class="token punctuation">{</span></span><span class="dl same">    program<span class="token punctuation">.</span><span class="token function">parse</span><span class="token punctuation">(</span><span class="token punctuation">[</span><span class="token operator">...</span>argv<span class="token punctuation">]</span><span class="token punctuation">,</span> <span class="token punctuation">{</span> from<span class="token operator">:</span> <span class="token string">'user'</span> <span class="token punctuation">}</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span> <span class="token keyword">catch</span> <span class="token punctuation">(</span>err<span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl same">    <span class="token keyword">if</span> <span class="token punctuation">(</span><span class="token operator">!</span><span class="token punctuation">(</span>err <span class="token keyword">instanceof</span> <span class="token class-name">HelpRequested</span><span class="token punctuation">)</span><span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl same">      <span class="token keyword">if</span> <span class="token punctuation">(</span>errored <span class="token operator">!==</span> <span class="token keyword">undefined</span><span class="token punctuation">)</span> <span class="token punctuation">{</span></span><span class="dl same">        <span class="token keyword">const</span> cause <span class="token operator">=</span> err <span class="token keyword">instanceof</span> <span class="token class-name">Error</span> <span class="token operator">?</span> err <span class="token operator">:</span> <span class="token keyword">new</span> <span class="token class-name">Error</span><span class="token punctuation">(</span><span class="token function">String</span><span class="token punctuation">(</span>err<span class="token punctuation">)</span><span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">        onUsageError<span class="token operator">?.</span><span class="token punctuation">(</span>errored<span class="token punctuation">,</span> cause<span class="token punctuation">)</span><span class="token punctuation">;</span></span><span class="dl same">      <span class="token punctuation">}</span></span><span class="dl same">      <span class="token keyword">return</span> <span class="token keyword">undefined</span><span class="token punctuation">;</span></span><span class="dl same">    <span class="token punctuation">}</span></span><span class="dl same">    <span class="token keyword">return</span> onHelp <span class="token operator">!==</span> <span class="token keyword">undefined</span></span><span class="dl same">      <span class="token operator">?</span> <span class="token function">onHelp</span><span class="token punctuation">(</span>err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">name</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">,</span> err<span class="token punctuation">.</span>command<span class="token punctuation">.</span><span class="token function">helpInformation</span><span class="token punctuation">(</span><span class="token punctuation">)</span><span class="token punctuation">)</span></span><span class="dl same">      <span class="token operator">:</span> err<span class="token punctuation">;</span></span><span class="dl same">  <span class="token punctuation">}</span></span><span class="dl same">  <span class="token keyword">return</span> invocation<span class="token punctuation">;</span></span><span class="dl same"><span class="token punctuation">}</span></span></pre></div></div><div class="vw" data-view="G2b" hidden><p class="vcap">Shown whole rather than marked line by line: it is not the same code as today’s walk.</p><div class="pic"><div class="btag"><span>sketch (feasibility not checked)</span></div><pre>parseQuietly(program, args, err =&gt;
  err instanceof HelpRequested
    ? { help: err.command }
    : commanderCode(err) === &quot;commander.helpDisplayed&quot;
      ? { help: currentCommand(program) }
      : undefined,
)</pre></div></div></div><div class="card" data-ruling="G2"><div class="scroll"><table style="--n:2"><thead><tr><td></td><th scope="col" data-k="a"><div class="oh"><span class="disc">a</span><span><span class="ot">Drop the call that replaces the caller’s handler</span><span class="tags"><span class="tag">recommended</span></span></span></div></th><th scope="col" data-k="b"><div class="oh"><span class="disc">b</span><span><span class="ot">Keep it; teach each caller to recognise a help request</span></span></div></th></tr></thead><tbody><tr class="grp"><th scope="colgroup"><span class="lbl">On the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">Subcommand help prints its own usage</th><td data-k="a"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">In all three CLIs at once; three failing tests pass.</span></div></td><td data-k="b"><div class="cell"><span class="mk mixed" role="img" aria-label="mixed">–</span><span class="why">Only in a CLI whose error handler learns the help case; statusline first.</span></div></td></tr><tr class="grp"><th scope="colgroup"><span class="lbl">Beyond the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">The trap for the next CLI</th><td data-k="a"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">Gone.</span></div></td><td data-k="b"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">Still set; every future CLI with its own handler meets it again.</span></div></td></tr><tr><th scope="row">Shared code that changes</th><td data-k="a"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">Core changes under all six callers; none relies on the silent default.</span></div></td><td data-k="b"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">None.</span></div></td></tr></tbody><tfoot><tr><td></td><td data-k="a"><label class="pick"><input type="radio" name="G2" value="a" data-pick="G2a"><span class="off">Pick a</span><span class="on">Picked a</span></label></td><td data-k="b"><label class="pick"><input type="radio" name="G2" value="b" data-pick="G2b"><span class="off">Pick b</span><span class="on">Picked b</span></label></td></tr></tfoot></table></div><div class="key"><span><i class="mk gain">✓</i>gain</span><span><i class="mk mixed">–</i>mixed</span><span><i class="mk cost">✕</i>cost</span></div><div class="none" data-k="n"><label class="pick"><input type="radio" name="G2" value="n" data-pick="G2n"><span class="off">None of these fit</span><span class="on">Picked none</span></label></div></div><p class="because"><span class="lbl">Why</span>a, because <i>subcommand help prints its own usage</i> everywhere and <i>the trap for the next CLI</i> goes; it pays in <i>shared code that changes</i>.</p><label class="nlabel" for="note-G2">Note on G2</label><textarea class="rnote" id="note-G2" name="note-G2" data-note="G2" rows="1"></textarea></section>
<section class="ruling" id="r-G4"><span class="rid">G4</span><h3>Who re-arms a reader’s window after a daemon restart?</h3><p class="stake"><b>Roughly 1 daemon restart a week lands mid-read; each one pays a leaf read’s holder half into the void until a human notices.</b></p><div class="stage"><div class="vtabs" role="group" aria-label="Picture"><button type="button" class="vt" data-view="today" aria-pressed="true">Today</button><button type="button" class="vt" data-view="G4a" aria-pressed="false"><span class="disc">a</span>The daemon re-arms its windows on start</button><button type="button" class="vt" data-view="G4b" aria-pressed="false"><span class="disc">b</span>The read re-arms the window before paying</button></div><div class="vw" data-view="today"><p class="vcap"><b>Today a crash loses the window; the read pays into the void until a human rebuilds it.</b></p><div class="pic"><div class="legend"><span style="--k:var(--k-call)"><i></i>a call or a reply</span><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span style="--k:var(--k-fail)"><i></i>an error</span></div><div class="scroll"><svg class="seq" viewBox="0 0 906 270" width="906" height="270" role="img" aria-label="Today a crash loses the window; the read pays into the void until a human rebuilds it."><rect class="ledger-bg" x="784" y="8" width="120" height="256" rx="4"/><line class="life" x1="177" y1="56" x2="177" y2="262"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="347" y1="56" x2="347" y2="262"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="517" y1="56" x2="517" y2="262"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Reader</text></g><line class="life" x1="687" y1="56" x2="687" y2="262"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">On call</text></g><text class="balh" x="844" y="32" text-anchor="middle">Windows</text><text class="balh" x="844" y="46" text-anchor="middle">armed</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">1</text><g><g class="self k-fail"><rect x="92" y="100" width="311.6" height="36" rx="13"/><text x="247.8" y="117" text-anchor="middle">daemon restarts mid-read</text><text class="sub" x="247.8" y="132" text-anchor="middle">the window lives only in the daemon’s memory</text></g><text class="num" x="14" y="122" text-anchor="middle">1</text></g><text class="bal chg" x="844" y="122" text-anchor="middle">0</text><g class="ghost"><text class="num" x="14" y="168" text-anchor="middle">2</text><text class="ghosttag" x="26" y="167.5">only in a: daemon re-arms the window from Postgres</text><line class="ghostrule" x1="366" y1="164" x2="764" y2="164"/></g><g><g class="self k-money"><rect x="364.4" y="187" width="305.2" height="26" rx="13"/><text x="517" y="204" text-anchor="middle">the read pays the holder half into the void</text></g><text class="num" x="14" y="204" text-anchor="middle">3</text></g><g><g class="e k-call"><line x1="687" y1="240" x2="181" y2="240"/><polygon class="head" points="177,240 186,235 186,245"/><text x="432" y="232" text-anchor="middle">a human rebuilds the window from the console</text></g><text class="num" x="14" y="244" text-anchor="middle">4</text></g><text class="bal chg" x="844" y="244" text-anchor="middle">1</text></svg></div></div></div><div class="vw" data-view="G4a" hidden><p class="vcap"><b>The daemon re-arms its windows from Postgres on start.</b> No void window.</p><div class="pic"><div class="legend"><span style="--k:var(--k-call)"><i></i>a call or a reply</span><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span style="--k:var(--k-fail)"><i></i>an error</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 906 328" width="906" height="328" role="img" aria-label="The daemon re-arms its windows from Postgres on start. No void window."><rect class="ledger-bg" x="784" y="8" width="120" height="314" rx="4"/><rect class="band" x="4" y="152" width="768" height="50" rx="3"/><rect class="band" x="4" y="206" width="768" height="68" rx="3"/><rect class="band" x="4" y="278" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="320"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="347" y1="56" x2="347" y2="320"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="517" y1="56" x2="517" y2="320"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Reader</text></g><line class="life" x1="687" y1="56" x2="687" y2="320"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">On call</text></g><text class="balh" x="844" y="32" text-anchor="middle">Windows</text><text class="balh" x="844" y="46" text-anchor="middle">armed</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">1</text><g class="same"><g class="self k-fail"><rect x="92" y="100" width="311.6" height="36" rx="13"/><text x="247.8" y="117" text-anchor="middle">daemon restarts mid-read</text><text class="sub" x="247.8" y="132" text-anchor="middle">the window lives only in the daemon’s memory</text></g><text class="num" x="14" y="122" text-anchor="middle">1</text></g><text class="bal chg" x="844" y="122" text-anchor="middle">0</text><g><g class="e k-store"><line x1="177" y1="172" x2="343" y2="172"/><polygon class="head" points="347,172 338,167 338,177"/><text x="262" y="164" text-anchor="middle">daemon re-arms the window from Postgres</text><text class="sub" x="262" y="188" text-anchor="middle">one more table the daemon owns</text></g><text class="num" x="14" y="176" text-anchor="middle">2</text><g class="tg tg-new"><rect x="26" y="163" width="58" height="18" rx="4"/><text x="55" y="176" text-anchor="middle">new</text></g></g><text class="bal chg" x="844" y="176" text-anchor="middle">1</text><g><g class="self k-money"><rect x="431.6" y="213" width="170.8" height="26" rx="13"/><text x="517" y="230" text-anchor="middle">the read pays the band</text></g><text class="num" x="14" y="230" text-anchor="middle">3</text><g class="tg tg-changed"><rect x="26" y="217" width="58" height="18" rx="4"/><text x="55" y="230" text-anchor="middle">changed</text></g></g><text class="was" x="517" y="251" text-anchor="middle">was <tspan class="old">the read pays the holder half into the void</tspan></text><text class="note" x="517" y="267" text-anchor="middle">the window survived the restart</text><g class="gone"><g class="e k-call"><line x1="687" y1="298" x2="181" y2="298"/><polygon class="head" points="177,298 186,293 186,303"/><text x="432" y="290" text-anchor="middle">a human rebuilds the window from the console</text></g><line class="strike" x1="291.2" y1="286" x2="572.8" y2="286"/><text class="num" x="14" y="302" text-anchor="middle">4</text><g class="tg tg-gone"><rect x="26" y="289" width="58" height="18" rx="4"/><text x="55" y="302" text-anchor="middle">gone</text></g></g></svg></div></div></div><div class="vw" data-view="G4b" hidden><p class="vcap"><b>The read re-arms the window before paying.</b> One extra write per read.</p><div class="pic"><div class="legend"><span style="--k:var(--k-call)"><i></i>a call or a reply</span><span style="--k:var(--k-money)"><i></i>money moves</span><span style="--k:var(--k-store)"><i></i>a write that lasts</span><span style="--k:var(--k-fail)"><i></i>an error</span><span><b class="sw"></b>what this option changes</span></div><div class="scroll"><svg class="seq" viewBox="0 0 906 302" width="906" height="302" role="img" aria-label="The read re-arms the window before paying. One extra write per read."><rect class="ledger-bg" x="784" y="8" width="120" height="288" rx="4"/><rect class="band" x="4" y="180" width="768" height="68" rx="3"/><rect class="band" x="4" y="252" width="768" height="36" rx="3"/><line class="life" x1="177" y1="56" x2="177" y2="294"/><g class="actor"><rect x="100" y="12" width="154" height="44" rx="4"/><text x="177" y="39" text-anchor="middle">Daemon</text></g><line class="life" x1="347" y1="56" x2="347" y2="294"/><g class="actor"><rect x="270" y="12" width="154" height="44" rx="4"/><text x="347" y="39" text-anchor="middle">Postgres</text></g><line class="life" x1="517" y1="56" x2="517" y2="294"/><g class="actor"><rect x="440" y="12" width="154" height="44" rx="4"/><text x="517" y="39" text-anchor="middle">Reader</text></g><line class="life" x1="687" y1="56" x2="687" y2="294"/><g class="actor"><rect x="610" y="12" width="154" height="44" rx="4"/><text x="687" y="39" text-anchor="middle">On call</text></g><text class="balh" x="844" y="32" text-anchor="middle">Windows</text><text class="balh" x="844" y="46" text-anchor="middle">armed</text><text class="num" x="4" y="90">start</text><text class="bal" x="844" y="90" text-anchor="middle">1</text><g class="same"><g class="self k-fail"><rect x="92" y="100" width="311.6" height="36" rx="13"/><text x="247.8" y="117" text-anchor="middle">daemon restarts mid-read</text><text class="sub" x="247.8" y="132" text-anchor="middle">the window lives only in the daemon’s memory</text></g><text class="num" x="14" y="122" text-anchor="middle">1</text></g><text class="bal chg" x="844" y="122" text-anchor="middle">0</text><g class="ghost"><text class="num" x="14" y="168" text-anchor="middle">2</text><text class="ghosttag" x="26" y="167.5">only in a: daemon re-arms the window from Postgres</text><line class="ghostrule" x1="366" y1="164" x2="764" y2="164"/></g><g><g class="self k-money"><rect x="351.6" y="187" width="330.8" height="26" rx="13"/><text x="517" y="204" text-anchor="middle">the read re-arms the window, then pays the band</text></g><text class="num" x="14" y="204" text-anchor="middle">3</text><g class="tg tg-changed"><rect x="26" y="191" width="58" height="18" rx="4"/><text x="55" y="204" text-anchor="middle">changed</text></g></g><text class="was" x="517" y="225" text-anchor="middle">was <tspan class="old">the read pays the holder half into the void</tspan></text><text class="note" x="517" y="241" text-anchor="middle">one extra write per read</text><text class="bal chg" x="844" y="204" text-anchor="middle">1</text><g class="gone"><g class="e k-call"><line x1="687" y1="272" x2="181" y2="272"/><polygon class="head" points="177,272 186,267 186,277"/><text x="432" y="264" text-anchor="middle">a human rebuilds the window from the console</text></g><line class="strike" x1="291.2" y1="260" x2="572.8" y2="260"/><text class="num" x="14" y="276" text-anchor="middle">4</text><g class="tg tg-gone"><rect x="26" y="263" width="58" height="18" rx="4"/><text x="55" y="276" text-anchor="middle">gone</text></g></g></svg></div></div></div></div><div class="card" data-ruling="G4"><div class="scroll"><table style="--n:2"><thead><tr><td></td><th scope="col" data-k="a"><div class="oh"><span class="disc">a</span><span><span class="ot">The daemon re-arms its windows on start</span><span class="tags"><span class="tag">recommended</span></span></span></div></th><th scope="col" data-k="b"><div class="oh"><span class="disc">b</span><span><span class="ot">The read re-arms the window before paying</span></span></div></th></tr></thead><tbody><tr class="grp"><th scope="colgroup"><span class="lbl">On the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">The window is back before the first read</th><td data-k="a"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">Re-armed at start, before any read arrives.</span></div></td><td data-k="b"><div class="cell"><span class="mk mixed" role="img" aria-label="mixed">–</span><span class="why">Re-armed by the first read, inside its own transaction.</span></div></td></tr><tr class="grp"><th scope="colgroup"><span class="lbl">Beyond the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">State the daemon owns</th><td data-k="a"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">One more table the daemon owns and migrates; start grows a step.</span></div></td><td data-k="b"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">No new owner of state; no daemon change.</span></div></td></tr><tr><th scope="row">Writes per read</th><td data-k="a"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">Unchanged.</span></div></td><td data-k="b"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">One more on every read, about 40 a day at current traffic.</span></div></td></tr></tbody><tfoot><tr><td></td><td data-k="a"><label class="pick"><input type="radio" name="G4" value="a" data-pick="G4a"><span class="off">Pick a</span><span class="on">Picked a</span></label></td><td data-k="b"><label class="pick"><input type="radio" name="G4" value="b" data-pick="G4b"><span class="off">Pick b</span><span class="on">Picked b</span></label></td></tr></tfoot></table></div><div class="key"><span><i class="mk gain">✓</i>gain</span><span><i class="mk mixed">–</i>mixed</span><span><i class="mk cost">✕</i>cost</span></div><div class="none" data-k="n"><label class="pick"><input type="radio" name="G4" value="n" data-pick="G4n"><span class="off">None of these fit</span><span class="on">Picked none</span></label></div></div><p class="because"><span class="lbl">Why</span>a, because <i>the window is back before the first read</i> and <i>writes per read</i> stay unchanged; it pays in <i>state the daemon owns</i>.</p><label class="nlabel" for="note-G4">Note on G4</label><textarea class="rnote" id="note-G4" name="note-G4" data-note="G4" rows="1"></textarea></section>
<section class="ruling" id="r-G5"><span class="rid">G5</span><h3>Should the daemon refuse to serve when its start check fails?</h3><p class="stake"><b>Every daemon start runs 1 ledger check whose failure stops nothing: readers pay into a ledger the daemon itself doubted, and a log line is the only sign.</b></p><div class="card" data-ruling="G5"><div class="scroll"><table style="--n:2"><thead><tr><td></td><th scope="col" data-k="a"><div class="oh"><span class="disc">a</span><span><span class="ot">Refuse to serve when the check fails</span><span class="tags"><span class="tag">recommended</span></span></span></div></th><th scope="col" data-k="b"><div class="oh"><span class="disc">b</span><span><span class="ot">Keep serving on a failed check</span><span class="tags"><span class="tag quiet">as today</span></span></span></div></th></tr></thead><tbody><tr class="grp"><th scope="colgroup"><span class="lbl">On the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">A doubted ledger is seen</th><td data-k="a"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">The on-call sees a stopped daemon with a reason.</span></div></td><td data-k="b"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">A log line nobody is reading.</span></div></td></tr><tr class="grp"><th scope="colgroup"><span class="lbl">Beyond the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">Reads during a flaky check</th><td data-k="a"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">One flaky check stops every read until a human restarts the daemon.</span></div></td><td data-k="b"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">Reads continue.</span></div></td></tr></tbody><tfoot><tr><td></td><td data-k="a"><label class="pick"><input type="radio" name="G5" value="a" data-pick="G5a"><span class="off">Pick a</span><span class="on">Picked a</span></label></td><td data-k="b"><label class="pick"><input type="radio" name="G5" value="b" data-pick="G5b"><span class="off">Pick b</span><span class="on">Picked b</span></label></td></tr></tfoot></table></div><div class="key"><span><i class="mk gain">✓</i>gain</span><span><i class="mk mixed">–</i>mixed</span><span><i class="mk cost">✕</i>cost</span></div><div class="none" data-k="n"><label class="pick"><input type="radio" name="G5" value="n" data-pick="G5n"><span class="off">None of these fit</span><span class="on">Picked none</span></label></div></div><p class="because"><span class="lbl">Why</span>a, because <i>a doubted ledger is seen</i>; it pays in <i>reads during a flaky check</i>.</p><label class="nlabel" for="note-G5">Note on G5</label><textarea class="rnote" id="note-G5" name="note-G5" data-note="G5" rows="1"></textarea></section>
<section class="ruling" id="r-G6"><span class="rid">G6</span><h3>Does a reader’s receipt show the blocks that paid no owner?</h3><p class="stake"><b>Paul’s receipt for a 2,400 read says 1,200 went to owners and never says why the other half did not.</b></p><p class="must"><span class="lbl">Must</span>Paul reads one receipt; nothing sends him to a second page.</p><p class="cut">Cut by the must: c (<s>A separate report of unowned blocks</s>). It is a second page Paul has to find. To bring it back, pick <b>n</b> and say so in the note.</p><p class="vcap"><b>Today the receipt has no line for the 10 blocks that paid nobody.</b></p><div class="strip" style="--n:2"><div class="panel today" data-k="b"><div class="ph"><span class="disc">b</span>Today</div><div class="fig"><div style="font: var(--s)/1.5 var(--mono); width: 300px"><div style="font: 500 var(--s) var(--sans); color: var(--muted); padding-bottom: 6px">Receipt</div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule)"><span>Reader [40, 50)</span><span>2,400</span></div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule); color: var(--muted)"><span>Paid to owners</span><span>1,200</span></div></div></div></div><div class="panel" data-k="a"><div class="ph"><span class="disc">a</span>Add an unowned line</div><div class="fig"><div style="font: var(--s)/1.5 var(--mono); width: 300px"><div style="font: 500 var(--s) var(--sans); color: var(--muted); padding-bottom: 6px">Receipt</div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule)"><span>Reader [40, 50)</span><span>2,400</span></div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule); color: var(--muted)"><span>Paid to owners</span><span>1,200</span></div><div style="display: flex; justify-content: space-between; gap: 32px; padding: 6px 0; border-top: 1px solid var(--rule); color: var(--o); font-weight: 500"><span>10 blocks with no owner</span><span>0</span></div></div></div><p class="pc"><b>The receipt names the 10 blocks that paid nobody.</b></p></div></div><div class="card" data-ruling="G6"><div class="scroll"><table style="--n:2"><thead><tr><td></td><th scope="col" data-k="a"><div class="oh"><span class="disc">a</span><span><span class="ot">Add an unowned line</span><span class="tags"><span class="tag">recommended</span></span></span></div></th><th scope="col" data-k="b"><div class="oh"><span class="disc">b</span><span><span class="ot">Keep the receipt as it is</span><span class="tags"><span class="tag quiet">as today</span></span></span></div></th></tr></thead><tbody><tr class="grp"><th scope="colgroup"><span class="lbl">On the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">Paul sees why half paid nobody</th><td data-k="a"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">One line names the 10 blocks with no owner.</span></div></td><td data-k="b"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">He finds out only by asking.</span></div></td></tr><tr class="grp"><th scope="colgroup"><span class="lbl">Beyond the stake</span></th><td data-k="a"></td><td data-k="b"></td></tr><tr><th scope="row">Receipt length</th><td data-k="a"><div class="cell"><span class="mk cost" role="img" aria-label="cost">✕</span><span class="why">Every receipt grows a line, zero on most reads.</span></div></td><td data-k="b"><div class="cell"><span class="mk gain" role="img" aria-label="gain">✓</span><span class="why">Unchanged.</span></div></td></tr></tbody><tfoot><tr><td></td><td data-k="a"><label class="pick"><input type="radio" name="G6" value="a" data-pick="G6a"><span class="off">Pick a</span><span class="on">Picked a</span></label></td><td data-k="b"><label class="pick"><input type="radio" name="G6" value="b" data-pick="G6b"><span class="off">Pick b</span><span class="on">Picked b</span></label></td></tr></tfoot></table></div><div class="key"><span><i class="mk gain">✓</i>gain</span><span><i class="mk mixed">–</i>mixed</span><span><i class="mk cost">✕</i>cost</span></div><div class="none" data-k="n"><label class="pick"><input type="radio" name="G6" value="n" data-pick="G6n"><span class="off">None of these fit</span><span class="on">Picked none</span></label></div></div><p class="because"><span class="lbl">Why</span>a, because <i>Paul sees why half paid nobody</i>; it pays in <i>receipt length</i>.</p><label class="nlabel" for="note-G6">Note on G6</label><textarea class="rnote" id="note-G6" name="note-G6" data-note="G6" rows="1"></textarea></section>
<section class="decided"><h2 class="lbl">Decided without you</h2><ul><li>Finding 1 is false: a band opens only on blocks that landed.</li><li>Finding 2 is ruled: dev databases reset.</li></ul></section>
<footer class="composer" id="rulings-composer">
<p class="rhint" id="rulings-hint" hidden>Restored from your last visit</p>
<div class="chips" id="picks" aria-live="polite"></div>
<label class="nlabel" for="rulings-notes">Page note</label>
<textarea id="rulings-notes" name="page-note" rows="1"></textarea>
<button type="button" class="go" id="copy-answer">Copy answer</button>
</footer>
</main>
<script>
(function () {
  'use strict';
  var KEY = document.body.getAttribute('data-key');
  function all(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }
  function store(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function stored(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

  var sections = all('section.ruling');
  var sum = document.getElementById('picks');
  var notesIn = document.getElementById('rulings-notes');
  var copyBtn = document.getElementById('copy-answer');
  var hintEl = document.getElementById('rulings-hint');

  var LIVE = {};
  var ORDER = [];
  all('input[data-pick]').forEach(function (i) {
    if (!LIVE[i.name]) { LIVE[i.name] = {}; ORDER.push(i.name); }
    LIVE[i.name][i.value] = true;
  });
  var pick = {};
  var onotes = {};
  var note = '';
  var restored = false;

  function load() {
    if (!KEY) return;
    var s;
    try { s = JSON.parse(stored(KEY) || 'null'); } catch (e) { return; }
    if (!s || typeof s !== 'object') return;
    var p = s.picks || {};
    for (var k in p) if (LIVE[k] && LIVE[k][p[k]]) pick[k] = p[k];
    var on = s.onotes || {};
    for (var t in on) if (typeof on[t] === 'string' && LIVE[t]) onotes[t] = on[t];
    if (typeof s.note === 'string') note = s.note;
    restored = Object.keys(pick).length > 0 || Object.keys(onotes).length > 0 || note !== '';
  }
  function save() {
    if (KEY) store(KEY, JSON.stringify({ picks: pick, onotes: onotes, note: note }));
  }

  function sectionOf(id) { return document.getElementById('r-' + id); }
  function show(section, view) {
    if (!section || !section.querySelector('.vw[data-view="' + view + '"]')) return;
    all('.vw', section).forEach(function (w) { w.hidden = w.getAttribute('data-view') !== view; });
    all('.vt', section).forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-view') === view ? 'true' : 'false'); });
  }
  function viewFor(section, k) {
    var id = section.id.slice(2);
    if (section.querySelector('.vw[data-view="' + id + k + '"]')) return id + k;
    var t = section.querySelector('.vt[data-view="today"] .disc');
    return t && t.textContent === k ? 'today' : null;
  }
  function rest(section) {
    var first = section.querySelector('.vw');
    if (!first) return;
    var p = pick[section.id.slice(2)];
    show(section, (p && viewFor(section, p)) || first.getAttribute('data-view'));
  }

  function render() {
    all('input[data-pick]').forEach(function (i) { i.checked = pick[i.name] === i.value; });
    sections.forEach(function (s) {
      var p = pick[s.id.slice(2)];
      all('[data-k]', s).forEach(function (c) { c.classList.toggle('picked', !!p && c.getAttribute('data-k') === p); });
    });
    if (hintEl) hintEl.hidden = !restored;
    var es = ORDER.filter(function (id) { return pick[id]; });
    sum.innerHTML = es.length === 0
      ? '<span class="empty">No picks yet</span>'
      : es.map(function (id) {
        return '<span class="chip"><i></i>' + id + pick[id] +
          '<button type="button" class="x" data-unpick="' + id + '" aria-label="unpick ' + id + pick[id] + '">×</button></span>';
      }).join('');
    copyBtn.disabled = answerText() === '';
  }
  function commit() { render(); save(); }
  function setPick(id, k) {
    if (pick[id] === k) delete pick[id];
    else pick[id] = k;
    rest(sectionOf(id));
    commit();
  }
  function endsDragSelect(e) {
    return e.detail > 0 && String(window.getSelection ? window.getSelection() : '') !== '';
  }

  document.addEventListener('click', function (e) {
    var t = e.target;
    var x = t.closest('[data-unpick]');
    if (x) { delete pick[x.getAttribute('data-unpick')]; rest(sectionOf(x.getAttribute('data-unpick'))); commit(); return; }
    var tab = t.closest('.vt');
    if (tab) { show(tab.closest('section'), tab.getAttribute('data-view')); return; }
    var cell = t.closest('.card [data-k]');
    if (!cell || t.closest('textarea')) return;
    if (t.closest('label.pick') && t.tagName !== 'INPUT') return;
    if (endsDragSelect(e)) { render(); return; }
    setPick(cell.closest('.card').getAttribute('data-ruling'), cell.getAttribute('data-k'));
  });
  document.addEventListener('change', function (e) {
    var i = e.target;
    if (!i.matches || !i.matches('input[data-pick]')) return;
    pick[i.name] = i.value;
    rest(sectionOf(i.name));
    commit();
  });

  function hover(section, k) {
    if (section.getAttribute('data-hov') === (k || '')) return;
    section.setAttribute('data-hov', k || '');
    all('.hov', section).forEach(function (c) { c.classList.remove('hov'); });
    if (k) all('[data-k="' + k + '"]', section).forEach(function (c) { c.classList.add('hov'); });
    var v = k && viewFor(section, k);
    if (v) show(section, v);
    else if (!k) rest(section);
  }
  document.addEventListener('mouseover', function (e) {
    var c = e.target.closest && e.target.closest('.card [data-k]');
    if (c) hover(c.closest('section'), c.getAttribute('data-k'));
  });
  all('.card').forEach(function (card) {
    card.addEventListener('mouseleave', function () { hover(card.closest('section'), null); });
  });

  function sizeNote() {
    notesIn.style.height = 'auto';
    notesIn.style.height = notesIn.scrollHeight + notesIn.offsetHeight - notesIn.clientHeight + 'px';
  }
  notesIn.addEventListener('input', function () { note = notesIn.value; commit(); sizeNote(); });
  all('.rnote').forEach(function (inp) {
    inp.addEventListener('input', function () { onotes[inp.getAttribute('data-note')] = inp.value; commit(); });
  });

  function answerText() {
    var line = ORDER.map(function (id) {
      var t = pick[id] ? id + pick[id] : id;
      var n = (onotes[id] || '').trim();
      return n ? t + ' — ' + n : pick[id] ? t : '';
    }).filter(Boolean).join(', ');
    var extra = note.trim();
    return extra ? (line ? line + '\\n\\n' : '') + extra : line;
  }
  function fallbackCopy(t) {
    var ta = document.createElement('textarea');
    ta.value = t;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    return ok;
  }
  function within(p, ms) {
    return new Promise(function (res) {
      var t = setTimeout(function () { res(false); }, ms);
      p.then(function () { clearTimeout(t); res(true); }, function () { clearTimeout(t); res(false); });
    });
  }
  function say(text) {
    copyBtn.textContent = text;
    setTimeout(function () { copyBtn.textContent = 'Copy answer'; }, 1800);
  }
  copyBtn.addEventListener('click', function () {
    var t = answerText();
    var done = function (ok) { say(ok ? 'Copied' : 'Copy failed. Copy the summary by hand.'); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      within(navigator.clipboard.writeText(t), 1500).then(function (ok) { done(ok || fallbackCopy(t)); });
    } else done(fallbackCopy(t));
  });

  load();
  sections.forEach(rest);
  notesIn.value = note;
  sizeNote();
  all('.rnote').forEach(function (inp) { inp.value = onotes[inp.getAttribute('data-note')] || ''; });
  render();
})();
</script>
</body>
</html>
"
`;
