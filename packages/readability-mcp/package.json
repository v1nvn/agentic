{
  "name": "@v1nvn/readability-mcp",
  "version": "0.15.0",
  "description": "MCP server that turns rendered (post-JS) HTML into clean Markdown + metadata via Readability, Turndown, and DOMPurify.",
  "type": "module",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "vite build",
    "bench": "vite-node test/bench/run.ts",
    "dev": "vite-node src/dev.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update-goldens": "UPDATE_GOLDENS=1 vitest run",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "readability",
    "markdown",
    "turndown",
    "model-context-protocol"
  ],
  "author": "v1nvn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v1nvn/agentic.git",
    "directory": "packages/readability-mcp"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.12",
    "jsdom": "^30.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "vite": "^8.1.4",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
